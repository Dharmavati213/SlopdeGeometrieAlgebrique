%% Shared macros for the unofficial English drafts of SGA 2.
%% Numbering follows the SMF recomposition (theorems share the subsection
%% counter, as in sga2-smf.sty). Do not load the SMF class.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sga2-en}[2026/09/12 English SGA 2 macros]

\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage[all,cmtip]{xy}
\RequirePackage{xspace}
\RequirePackage{enumitem}
\RequirePackage{url}
\RequirePackage{graphicx}

% --- theorem numbering as in the SMF SGA 2 (decimal / subsection) ---
\renewcommand{\thechapter}{\Roman{chapter}}
\renewcommand{\thesection}{\arabic{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}
\renewcommand{\theequation}{\arabic{equation}}
\setcounter{secnumdepth}{4}

\theoremstyle{plain}
\newtheorem{theorem}[subsection]{Theorem}
\newtheorem{proposition}[subsection]{Proposition}
\newtheorem{lemma}[subsection]{Lemma}
\newtheorem{corollary}[subsection]{Corollary}
\newtheorem{corollaries}[subsection]{Corollaries}
\newtheorem{conjecture}[subsection]{Conjecture}
\newtheorem{problem}[subsection]{Problem}
\newtheorem{theoremdefinition}[subsection]{Theorem and definition}
\newtheorem{subproposition}[subsubsection]{Proposition}
\newtheorem{propositionblah}[subsubsection]{Proposition}
\newtheorem{serrenormality}[subsection]{Serre's criterion for normality}
\newtheorem{sublemma}[subsubsection]{Lemma}
\newtheorem{subsublemma}[paragraph]{Lemma}
\newtheorem{supproposition}[section]{Proposition}
\newtheorem{suplemma}[section]{Lemma}
\newtheorem{suptheorem}[section]{Theorem}
\newtheorem{supcorollary}[section]{Corollary}

\newtheorem{aconjecture}{Conjecture}[section]
\renewcommand{\theaconjecture}{\Alph{aconjecture}}

\theoremstyle{definition}
\newtheorem{definition}[subsection]{Definition}
\theoremstyle{remark}
\newtheorem{remark}[subsection]{Remark}
\newtheorem{remarks}[subsection]{Remarks}
\newtheorem{example}[subsection]{Example}
\newtheorem{subremark}[subsubsection]{Remark}
\newtheorem{supdefinition}{Definition}[chapter]
\renewcommand{\thesupdefinition}{\arabic{supdefinition}}
\newtheorem*{remarkstar}{Remark}
\newtheorem*{remarksstar}{Remarks}

% Unnumbered named statements (SMF \enonce*)
\newenvironment{enonce*}[2][plain]
  {\par\addvspace{.5\baselineskip}\noindent\textsc{#2.}\ \itshape\ignorespaces}
  {\par\addvspace{.5\baselineskip}}

\newenvironment{namedstatement}[1]
  {\par\addvspace{.5\baselineskip}\noindent\textsc{#1.}\ \itshape\ignorespaces}
  {\par\addvspace{.5\baselineskip}}

% Aliases for French environment names left in a body by mistake
\let\theoreme\theorem
\let\lemme\lemma
\let\corollaire\corollary
\let\corollaires\corollaries
\let\probleme\problem
\let\theoremedefinition\theoremdefinition
\let\criteredenormalitedeserre\serrenormality
\let\sublemme\sublemma
\let\subsublemme\subsublemma
\let\suptheoreme\suptheorem
\let\supcorollaire\supcorollary
\let\remarque\remark
\let\remarques\remarks
\let\exemple\example
\let\subremarque\subremark
\let\remarquestar\remarkstar
\let\endtheoreme\endtheorem
\let\endlemme\endlemma
\let\endcorollaire\endcorollary
\let\endcorollaires\endcorollaries
\let\endprobleme\endproblem
\let\endtheoremedefinition\endtheoremdefinition
\let\endcriteredenormalitedeserre\endserrenormality
\let\endsublemme\endsublemma
\let\endsubsublemme\endsubsublemma
\let\endsuptheoreme\endsuptheorem
\let\endsupcorollaire\endsupcorollary
\let\endremarque\endremark
\let\endremarques\endremarks
\let\endexemple\endexample
\let\endsubremarque\endsubremark
\let\endremarquestar\endremarkstar

\let\skipqed\relax
\newcommand{\steco}{\setcounter{equation}{\value{yequation}}\refstepcounter{yequation}}
\newcounter{yequation}[chapter]
\newcounter{toto}
\ifcsname c@toto\endcsname\else\newcounter{toto}\fi

% --- references ---
\makeatletter
\newcommand{\SourceRef}[2]{\@ifundefined{r@#1}{#2}{\ref{#1}}}
% hyperref also defines \Ref; re-assert after \begin{document}.
\renewcommand{\Ref}[1]{\textup{\@ifundefined{r@#1}{\detokenize{#1}}{\ref{#1}}}}
\AtBeginDocument{%
  \renewcommand{\Ref}[1]{\textup{\@ifundefined{r@#1}{\detokenize{#1}}{\ref{#1}}}}%
  \let\H\rH
}
\makeatother

