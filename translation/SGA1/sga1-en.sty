% SMF bibliography: \begin{thebibliography}{widest label}{section label}
% opens a numbered section "Bibliography" carrying the given label
% (e.g. VIII.8), exactly as in the SMF volume.
\makeatletter
\renewenvironment{thebibliography}[2]{%
  \section{Bibliography}\label{#2}%
  \normalfont\labelsep .5em\relax
  \list{\@biblabel{\@arabic\c@enumiv}}{%
    \settowidth\labelwidth{\@biblabel{#1}}%
    \leftmargin\labelwidth \advance\leftmargin\labelsep
    \usecounter{enumiv}\let\p@enumiv\@empty
    \renewcommand\theenumiv{\@arabic\c@enumiv}}%
  \sloppy\clubpenalty\@M \widowpenalty\clubpenalty
  \sfcode`\.=\@m}
  {\def\@noitemerr{\@latex@warning{Empty `thebibliography' environment}}%
   \endlist}
\makeatother

