import SGA.SGA1.ExposeXI.HodgeLefschetzDescent
import SGA.SGA1.ExposeXI.HodgeLefschetzDescentAlgebra
import SGA.Foundations.Projective.AmpleAffine
import SGA.Foundations.Projective.Morphisms
import SGA.Foundations.Limits.SpreadingOutSubfield
import SGA.Foundations.Limits.FiniteEtale
import SGA.SGA1.ExposeVIII.TopologicalDescent
import SGA.SGA1.ExposeVIII.MorphismDescent

/-!
# Spreading out XI.1.4's data to a countable subfield

The spreading-out half of the Lefschetz principle for XI.1.4 (`SerreLefschetzDescentStatement`,
registry row A47): a smooth projective integral unirational scheme `X` over an algebraically closed
field `K` is the base change of one over a countable algebraically closed subfield `k₁ ⊆ K`.

* `exists_model_isQuasiProjective`: `X` together with an affine morphism `X ⟶ ℙ(σ; K)`
  (`IsQuasiProjective.exists_isAffineHom_projectiveSpace`) spreads out to a subfield `F ⊆ K`
  generated by a finite set (EGA IV 8.8.2 for schemes and morphisms, stream `ega4-8`); the model
  `X₀ ⟶ Spec F` is quasi-projective, because its morphism to `ℙ(σ; F)` is affine by fpqc descent.
* `serreLefschetzDescentStatement`: the statement. A nonempty affine chart of the model carries the
  unirational parametrization down to a subfield containing finitely many more elements
  (`exists_finset_isUnirational_of_isPushout`); `k₁` is the algebraic closure in `K` of the
  subfield generated by all of these, and properness, smoothness and connectedness descend from
  `X` to `X₁ = X₀ ×_F k₁` by fpqc descent.
* `serreUnirationalProjectiveStatement_of_hodgeSymmetryZeroComplex`: **XI.1.4 in SGA's form
  (projective `X`), over every algebraically closed field of characteristic `0`, in universe `0`,
  from `HodgeSymmetryZeroComplexStatement` alone** (Hodge symmetry over `ℂ`, stream `hodge`).

## References

* [EGA IV₃, 8.8.2, 8.10.5][EGA4]; [EGA IV₂, 2.7.1] (fpqc descent of properties of morphisms)
-/

universe u

open AlgebraicGeometry CategoryTheory Limits Cardinal

namespace SGA.SGA1.ExposeXI

open Scheme.SpreadingOutSubfield

section Model

variable {K : Type u} [Field K]

set_option backward.isDefEq.respectTransparency false in
/-- A quasi-projective `K`-scheme of finite type is the base change of a quasi-projective scheme of
finite type over a subfield `F ⊆ K` generated by a finite set: spread out `X` together with an
affine morphism `X ⟶ ℙ(σ; K)` (EGA IV 8.8.2); the morphism stays affine at the finite level by
fpqc descent. -/
theorem exists_model_isQuasiProjective {X : Scheme.{u}} (f : X ⟶ Spec (.of K))
    [LocallyOfFiniteType f] [QuasiCompact f] [QuasiSeparated f] [IsQuasiProjective f] :
    ∃ (F : Subfield K) (_ : ∃ s : Finset K, F = Subfield.closure (s : Set K)) (X₀ : Scheme.{u})
      (f₀ : X₀ ⟶ Spec (.of F)) (e : X ⟶ X₀), LocallyOfFiniteType f₀ ∧ IsQuasiProjective f₀ ∧
        IsPullback e f f₀ (Spec.map (CommRingCat.ofHom F.subtype)) := by
  obtain ⟨σ, _, φ, hφ, hφf⟩ := IsQuasiProjective.exists_isAffineHom_projectiveSpace f
  have : LocallyOfFinitePresentation f := inferInstance
  obtain ⟨j, X₀, q₀, e, h₁, h₂, h₃, h⟩ :=
    Scheme.exists_isPullback_of_isLimit_of_locallyOfFinitePresentation
      (E := schemeDiagram K) (c := Scheme.Spec.mapCone (cocone K).op) (isLimitSpecCone K) f
  have : IsLocallyNoetherian ((schemeDiagram K).obj j) := by
    change IsLocallyNoetherian (Spec (.of j.unop.1))
    infer_instance
  have : LocallyOfFinitePresentation (ℙ(σ; (schemeDiagram K).obj j) ↘ (schemeDiagram K).obj j) :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  obtain ⟨k, b, hb, hb'⟩ := Scheme.exists_hom_of_isPullback (isLimitSpecCone K)
    (ℙ(σ; (schemeDiagram K).obj j) ↘ (schemeDiagram K).obj j) h
    (φ ≫ ProjectiveSpace.map _ ((Scheme.Spec.mapCone (cocone K).op).π.app j)) (by
      rw [Category.assoc, ProjectiveSpace.map_over, ← Category.assoc, hφf])
  let fk := pullback.snd q₀ ((schemeDiagram K).map k.hom)
  let πk := (Scheme.baseChangeCone (E := schemeDiagram K)
    (c := Scheme.Spec.mapCone (cocone K).op) h).π.app k
  let ck : Spec (.of K) ⟶ Spec (.of k.left.unop.1) :=
    Spec.map (CommRingCat.ofHom (algebraMap k.left.unop.1 K))
  have hk : IsPullback πk f fk ck := Scheme.isPullback_baseChangeCone (E := schemeDiagram K)
    (c := Scheme.Spec.mapCone (cocone K).op) h k
  -- the morphism `X_k ⟶ ℙ(σ; F_k)`
  let φk : pullback q₀ ((schemeDiagram K).map k.hom) ⟶ ℙ(σ; Spec (.of k.left.unop.1)) :=
    pullback.lift fk (b ≫ ProjectiveSpace.toProj σ _) (terminal.hom_ext _ _)
  have hφk : φk ≫ ℙ(σ; Spec (.of k.left.unop.1)) ↘ Spec (.of k.left.unop.1) = fk :=
    pullback.lift_fst _ _ _
  have hφk' : φk ≫ ProjectiveSpace.toProj σ _ = b ≫ ProjectiveSpace.toProj σ _ :=
    pullback.lift_snd _ _ _
  have hkey : φ ≫ ProjectiveSpace.map _ ck = πk ≫ φk := by
    refine pullback.hom_ext ?_ ?_
    · change (φ ≫ ProjectiveSpace.map _ ck) ≫
          ℙ(σ; Spec (.of k.left.unop.1)) ↘ Spec (.of k.left.unop.1) =
        (πk ≫ φk) ≫ ℙ(σ; Spec (.of k.left.unop.1)) ↘ Spec (.of k.left.unop.1)
      rw [Category.assoc, ProjectiveSpace.map_over, ← Category.assoc, hφf, Category.assoc, hφk,
        hk.w]
    · change (φ ≫ ProjectiveSpace.map _ ck) ≫ ProjectiveSpace.toProj σ _ =
        (πk ≫ φk) ≫ ProjectiveSpace.toProj σ _
      rw [Category.assoc, ProjectiveSpace.map_toProj, Category.assoc, hφk', ← Category.assoc]
      change _ = ((Scheme.baseChangeCone h).π.app k ≫ b) ≫ _
      rw [hb', Category.assoc, ProjectiveSpace.map_toProj]
  have hP : IsPullback (ℙ(σ; Spec (.of K)) ↘ Spec (.of K)) (ProjectiveSpace.map _ ck) ck
      (ℙ(σ; Spec (.of k.left.unop.1)) ↘ Spec (.of k.left.unop.1)) :=
    (ProjectiveSpace.isPullback_map ck).flip
  have ho : IsPullback (φ ≫ ℙ(σ; Spec (.of K)) ↘ Spec (.of K)) πk ck
      (φk ≫ ℙ(σ; Spec (.of k.left.unop.1)) ↘ Spec (.of k.left.unop.1)) := by
    rw [hφf, hφk]
    exact hk.flip
  have hsq : IsPullback φ πk (ProjectiveSpace.map _ ck) φk := IsPullback.of_right ho hkey hP
  have hcov : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u})
      (ProjectiveSpace.map (σ := σ) _ ck) := by
    have hc : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) ck :=
      ⟨⟨inferInstance, inferInstance⟩, inferInstance⟩
    exact MorphismProperty.of_isPullback hP hc
  have : IsAffineHom φk := MorphismProperty.of_isPullback_of_descendsAlong hsq hcov hφ
  have : LocallyOfFiniteType φk := by
    have : LocallyOfFiniteType
        (φk ≫ ℙ(σ; Spec (.of k.left.unop.1)) ↘ Spec (.of k.left.unop.1)) := by
      rw [hφk]; infer_instance
    exact locallyOfFiniteType_of_comp φk
      (ℙ(σ; Spec (.of k.left.unop.1)) ↘ Spec (.of k.left.unop.1))
  have : IsHProjective (ℙ(σ; Spec (.of k.left.unop.1)) ↘ Spec (.of k.left.unop.1)) :=
    inferInstance
  have : IsQuasiProjective (ℙ(σ; Spec (.of k.left.unop.1)) ↘ Spec (.of k.left.unop.1)) :=
    IsHProjective.isQuasiProjective _
  have : IsQuasiProjective fk := by
    rw [← hφk]
    exact IsQuasiProjective.comp_of_isAffineHom φk _
  exact ⟨k.left.unop.1, k.left.unop.2, _, fk, _, inferInstance, inferInstance, hk⟩

end Model

section Descent

set_option backward.isDefEq.respectTransparency false in
/-- **XI.1.4, Lefschetz principle, spreading-out half** (`SerreLefschetzDescentStatement`): a
smooth projective integral unirational scheme over an algebraically closed field `K` is the base
change of a smooth projective integral unirational scheme over a countable algebraically closed
subfield `k₁ ⊆ K`. -/
theorem serreLefschetzDescentStatement : SerreLefschetzDescentStatement.{u} := by
  intro K _ _ _ X _ f _ _ _ h
  obtain ⟨F, ⟨s, hFs⟩, X₀, f₀, e, hf₀, hqp, H⟩ := exists_model_isQuasiProjective f
  have : IsAffineHom e := MorphismProperty.of_isPullback H.flip inferInstance
  -- a nonempty affine chart `U₀ ⊆ X₀` and its inverse image `U ⊆ X`
  obtain ⟨x⟩ : Nonempty X := inferInstance
  obtain ⟨_, ⟨U₀, hU₀, rfl⟩, hxU₀, -⟩ :=
    X₀.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (e x)) isOpen_univ
  have : Nonempty (e ⁻¹ᵁ U₀) := ⟨⟨x, hxU₀⟩⟩
  have hU : IsAffineOpen (e ⁻¹ᵁ U₀) := hU₀.preimage e
  -- the rings `A = Γ(X₀, U₀)` and `B = Γ(X, U) = K ⊗_F A`
  have HA := CohomologyAux.isPushout_baseChange H hU₀
  let a₁ := ((Scheme.ΓSpecIso (.of F)).inv ≫ f₀.appLE ⊤ U₀ le_top).hom
  let a₃ := (e.appLE U₀ (e ⁻¹ᵁ U₀) le_rfl).hom
  let a₄ := ((Scheme.ΓSpecIso (.of K)).inv ≫ f.appLE ⊤ (e ⁻¹ᵁ U₀) le_top).hom
  let _ : Algebra F Γ(X₀, U₀) := a₁.toAlgebra
  let _ : Algebra Γ(X₀, U₀) Γ(X, e ⁻¹ᵁ U₀) := a₃.toAlgebra
  let _ : Algebra K Γ(X, e ⁻¹ᵁ U₀) := a₄.toAlgebra
  have : IsScalarTower F Γ(X₀, U₀) Γ(X, e ⁻¹ᵁ U₀) :=
    IsScalarTower.of_algebraMap_eq' (congrArg CommRingCat.Hom.hom HA.w).symm
  have : IsScalarTower F K Γ(X, e ⁻¹ᵁ U₀) := IsScalarTower.of_algebraMap_eq' rfl
  have : Algebra.IsPushout F Γ(X₀, U₀) K Γ(X, e ⁻¹ᵁ U₀) :=
    CommRingCat.isPushout_iff_isPushout.mp HA
  have : Algebra.IsPushout F K Γ(X₀, U₀) Γ(X, e ⁻¹ᵁ U₀) := Algebra.IsPushout.symm this
  have : Algebra.FiniteType F Γ(X₀, U₀) := by
    have h1 := HasRingHomProperty.appLE (P := @LocallyOfFiniteType) f₀ hf₀
      ⟨⊤, isAffineOpen_top _⟩ ⟨U₀, hU₀⟩ le_top
    have h2 : ((Scheme.ΓSpecIso (.of F)).inv).hom.FiniteType :=
      RingHom.FiniteType.of_surjective _
        (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of F)).inv).2
    exact h1.comp h2
  let _ : Algebra K X.functionField := (functionFieldMap f).toAlgebra
  have : IsFractionRing Γ(X, e ⁻¹ᵁ U₀) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X _ hU
  have : IsScalarTower K Γ(X, e ⁻¹ᵁ U₀) X.functionField :=
    IsScalarTower.of_algebraMap_eq' (germToFunctionField_comp_appLE f _).symm
  have : Algebra.EssFiniteType K X.functionField := essFiniteType_functionFieldMap f
  obtain ⟨S, hS⟩ :=
    exists_finset_isUnirational_of_isPushout (F := F) Γ(X₀, U₀) Γ(X, e ⁻¹ᵁ U₀) h
  -- the countable algebraically closed subfield `k₁`
  classical
  let F' := Subfield.closure (((s ∪ S : Finset K)) : Set K)
  let k₁ : Subfield K := (algebraicClosure F' K).toSubfield
  have hF'k : F' ≤ k₁ := fun y hy ↦ (algebraicClosure F' K).algebraMap_mem ⟨y, hy⟩
  have hFk : F ≤ k₁ := by
    rw [hFs]
    exact (Subfield.closure_mono (by simp)).trans hF'k
  have hSk : (S : Set K) ⊆ Set.range (algebraMap k₁ K) := fun y hy ↦
    ⟨⟨y, hF'k (Subfield.subset_closure (by simp [hy]))⟩, rfl⟩
  have hk₁ : IsAlgClosed k₁ := IsAlgClosure.isAlgClosed (R := F') (K := algebraicClosure F' K)
  have hk₁c : Countable k₁ := by
    have hF' : Countable F' := by
      rw [← Cardinal.mk_le_aleph0_iff]
      refine (Subfield.cardinalMk_closure_le_max _).trans (max_le ?_ le_rfl)
      exact Cardinal.mk_le_aleph0_iff.mpr ((s ∪ S).finite_toSet.countable.to_subtype)
    rw [← Cardinal.mk_le_aleph0_iff]
    have : #k₁ ≤ #{x : K // IsAlgebraic F' x} :=
      Cardinal.mk_le_mk_of_subset fun x hx ↦ mem_algebraicClosure_iff.mp hx
    refine this.trans ((Algebraic.cardinalMk_le_max F' K).trans (max_le ?_ le_rfl))
    exact Cardinal.mk_le_aleph0_iff.mpr hF'
  -- the model `X₁ = X₀ ×_F k₁`
  obtain ⟨e₁, H₁⟩ := Scheme.exists_isPullback_subfield_of_le hFk H
  let ρ₂ := Spec.map (CommRingCat.ofHom (Subfield.inclusion hFk))
  let f₁ := pullback.snd f₀ ρ₂
  have hρ₁ : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u})
      (Spec.map (CommRingCat.ofHom k₁.subtype)) :=
    ⟨⟨inferInstanceAs (Surjective (Spec.map (CommRingCat.ofHom (algebraMap k₁ K)))),
      inferInstanceAs (Flat (Spec.map (CommRingCat.ofHom (algebraMap k₁ K))))⟩, inferInstance⟩
  have : IsProper f₁ := MorphismProperty.of_isPullback_of_descendsAlong H₁.flip hρ₁ ‹IsProper f›
  have : Smooth f₁ := MorphismProperty.of_isPullback_of_descendsAlong H₁.flip hρ₁ ‹Smooth f›
  have : IsQuasiProjective f₁ := IsQuasiProjective.of_isPullback (IsPullback.of_hasPullback f₀ ρ₂)
  have : Surjective e₁ := MorphismProperty.of_isPullback H₁.flip hρ₁.1.1
  have : ConnectedSpace ↥(pullback f₀ ρ₂) := e₁.surjective.connectedSpace e₁.continuous
  have hint : IsIntegral (pullback f₀ ρ₂) :=
    (ExposeX.isIntegral_and_isNormalScheme_of_smooth k₁ f₁).1
  -- unirationality of `X₁`, on the chart `U₁ = U₀ ×_F k₁`
  have : Subsingleton (Spec (.of F)) := inferInstanceAs (Subsingleton (PrimeSpectrum F))
  have : Nonempty (Spec (.of k₁)) := inferInstanceAs (Nonempty (PrimeSpectrum k₁))
  have : Surjective ρ₂ := ⟨fun y ↦ ⟨Nonempty.some inferInstance, Subsingleton.elim _ _⟩⟩
  set U₁ := pullback.fst f₀ ρ₂ ⁻¹ᵁ U₀
  have : Nonempty U₁ := by
    obtain ⟨y, hy⟩ := (pullback.fst f₀ ρ₂).surjective (e x)
    exact ⟨⟨y, by rw [Scheme.Hom.mem_preimage, hy]; exact hxU₀⟩⟩
  have hU₁ : IsAffineOpen U₁ := hU₀.preimage _
  have HB := CohomologyAux.isPushout_baseChange (IsPullback.of_hasPullback f₀ ρ₂) hU₀
  let b₃ := ((pullback.fst f₀ ρ₂).appLE U₀ U₁ le_rfl).hom
  let b₄ := ((Scheme.ΓSpecIso (.of k₁)).inv ≫ f₁.appLE ⊤ U₁ le_top).hom
  let _ : Algebra F k₁ := (Subfield.inclusion hFk).toAlgebra
  have : IsScalarTower F k₁ K := IsScalarTower.of_algebraMap_eq' rfl
  let _ : Algebra Γ(X₀, U₀) Γ(pullback f₀ ρ₂, U₁) := b₃.toAlgebra
  let _ : Algebra k₁ Γ(pullback f₀ ρ₂, U₁) := b₄.toAlgebra
  let _ : Algebra F Γ(pullback f₀ ρ₂, U₁) := (b₃.comp a₁).toAlgebra
  have : IsScalarTower F Γ(X₀, U₀) Γ(pullback f₀ ρ₂, U₁) := IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower F k₁ Γ(pullback f₀ ρ₂, U₁) :=
    IsScalarTower.of_algebraMap_eq' (congrArg CommRingCat.Hom.hom HB.w)
  have : Algebra.IsPushout F Γ(X₀, U₀) k₁ Γ(pullback f₀ ρ₂, U₁) :=
    CommRingCat.isPushout_iff_isPushout.mp HB
  have : Algebra.IsPushout F k₁ Γ(X₀, U₀) Γ(pullback f₀ ρ₂, U₁) := Algebra.IsPushout.symm this
  let _ : Algebra k₁ (pullback f₀ ρ₂).functionField := (functionFieldMap f₁).toAlgebra
  have : IsFractionRing Γ(pullback f₀ ρ₂, U₁) (pullback f₀ ρ₂).functionField :=
    functionField_isFractionRing_of_isAffineOpen _ _ hU₁
  have : IsScalarTower k₁ Γ(pullback f₀ ρ₂, U₁) (pullback f₀ ρ₂).functionField :=
    IsScalarTower.of_algebraMap_eq' (germToFunctionField_comp_appLE f₁ _).symm
  have hunir := hS k₁ hSk Γ(pullback f₀ ρ₂, U₁) (pullback f₀ ρ₂).functionField
  exact ⟨k₁, pullback f₀ ρ₂, hint, f₁, e₁, hk₁, hk₁c, inferInstance, inferInstance, inferInstance,
    hunir, H₁⟩

/-- **XI.1.4 (Serre) in SGA's form, in universe `0`**, conditional only on Hodge symmetry over `ℂ`
(`HodgeSymmetryZeroComplexStatement`, stream `hodge`; not proved yet): a smooth projective
(proper and quasi-projective) integral scheme over an algebraically closed field of
characteristic `0`, with unirational function field, is simply connected. The Lefschetz
principle (`serreLefschetzDescentStatement`, then `k₁ ↪ ℂ` and X.1.8) reduces it to `ℂ`. -/
theorem serreUnirationalProjectiveStatement_of_hodgeSymmetryZeroComplex
    (hC : HodgeSymmetryZeroComplexStatement) : SerreUnirationalProjectiveStatement.{0} :=
  serreUnirationalProjectiveStatement_of_hodgeSymmetryZeroComplex_of_descent hC
    serreLefschetzDescentStatement

end Descent

end SGA.SGA1.ExposeXI
