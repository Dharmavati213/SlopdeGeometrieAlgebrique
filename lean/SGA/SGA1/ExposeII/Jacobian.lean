import Mathlib.AlgebraicGeometry.Morphisms.LocalFlatDescent
import Mathlib.AlgebraicGeometry.Morphisms.Smooth
import Mathlib.RingTheory.Etale.Descent
import Mathlib.RingTheory.LocalRing.Module
import Mathlib.RingTheory.LocalRing.Quotient
import Mathlib.RingTheory.Smooth.Local

/-!
# SGA 1, Exposé II, §4 (4.9–4.14): smooth subschemes and the Jacobian criterion

Let `X` be smooth over `S`, `Y ⊆ X` the closed subscheme defined by `𝒥`, and `x ∈ Y`. In the
affine local situation `P = 𝒪_{X,x}` (a local ring, formally smooth over `R` with `Ω¹_{P/R}`
finite free), `J = 𝒥_x` and `𝒪_{Y,x} = P ⧸ J`. We prove:

* (4.3 bis), the conormal sequence `J/J² → Ω¹_{P/R} ⊗ P/J → Ω¹_{(P/J)/R} → 0` (mathlib);
* II.4.10 (i) ⇔ (iv): `Y` is smooth iff `J/J² → Ω¹_{P/R} ⊗ P/J` is a split injection (mathlib);
* II.4.10 (i) ⇔ (iii), the **Jacobian criterion** (II.4.14): `Y` is smooth at `x` iff `J` is
  generated by elements `g₁,…,gₚ` whose differentials `dgᵢ(x)` are linearly independent in the
  fibre `Ω¹_{X/S}(x) = κ(x) ⊗ Ω¹_{P/R}`;
* II.4.12: the zero scheme of `F` is smooth at `x` iff `F = 0` near `x` or `dF(x) ≠ 0`;
* II.4.13, global form: smoothness descends along flat surjective base changes (mathlib; for
  schemes the base change is assumed quasi-compact, or locally of finite presentation).

Étale coordinates adapted to `Y` (II.4.9, II.4.10 (ii), II.4.11) are in
`SGA.SGA1.ExposeII.Coordinates`. The pointwise form of II.4.13, and the global form without
quasi-compactness, are in `SGA.SGA1.ExposeII.SmoothDescent`.
-/

universe u

open Algebra KaehlerDifferential TensorProduct IsLocalRing

namespace SGA.SGA1.ExposeII

section Conormal

variable (R P S : Type u) [CommRing R] [CommRing P] [CommRing S] [Algebra R P] [Algebra P S]
  [Algebra R S] [IsScalarTower R P S]

/-- II, formula (4.3 bis): for `P → S` surjective with kernel `J`, the sequence
`J/J² → S ⊗_P Ω¹_{P/R} → Ω¹_{S/R} → 0` is exact (mathlib). -/
theorem exact_kerCotangentToTensor_mapBaseChange (h : Function.Surjective (algebraMap P S)) :
    Function.Exact (kerCotangentToTensor R P S) (mapBaseChange R P S) ∧
      Function.Surjective (mapBaseChange R P S) :=
  ⟨KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R P S h,
    mapBaseChange_surjective R P S h⟩

/-- II.4.10 (i) ⇔ (iv): if `P` is formally smooth over `R` and `P → S` is surjective with kernel
`J`, then `S` is formally smooth over `R` iff `J/J² → S ⊗_P Ω¹_{P/R}` is a split injection
(mathlib, Stacks 031I). -/
theorem formallySmooth_iff_split_injection [FormallySmooth R P]
    (h : Function.Surjective (algebraMap P S)) :
    FormallySmooth R S ↔ ∃ l, l ∘ₗ kerCotangentToTensor R P S = LinearMap.id :=
  FormallySmooth.iff_split_injection h

end Conormal

section Jacobian

variable {R P : Type u} [CommRing R] [CommRing P] [Algebra R P] [IsLocalRing P]

omit [IsLocalRing P] in
/-- The span of the pure tensors `1 ⊗ m` is everything. -/
private lemma span_range_tmul_one (k M : Type*) [CommRing k] [Algebra P k] [AddCommGroup M]
    [Module P M] : Submodule.span k (Set.range fun m : M ↦ (1 : k) ⊗ₜ[P] m) = ⊤ := by
  have := Submodule.baseChange_span (R := P) (A := k) (Set.univ : Set M)
  rw [Submodule.span_univ, Submodule.baseChange_top, Set.image_univ] at this
  exact this.symm

/-- The data needed to apply mathlib's local Jacobian criterion to `P → P ⧸ J`, with the residue
field of `P` as test field. -/
private lemma formallySmooth_quotient_iff_injective [FormallySmooth R P]
    [Module.Free P Ω[P⁄R]] [Module.Finite P Ω[P⁄R]] (J : Ideal P) (hJ : J ≤ maximalIdeal P)
    (hJfg : J.FG) [Algebra (P ⧸ J) (ResidueField P)] [IsScalarTower P (P ⧸ J) (ResidueField P)] :
    FormallySmooth R (P ⧸ J) ↔
      Function.Injective (cotangentComplexBaseChange R (P ⧸ J) P (ResidueField P)) := by
  have : Nontrivial (P ⧸ J) :=
    Ideal.Quotient.nontrivial_iff.mpr (ne_top_of_le_ne_top (maximalIdeal.isMaximal P).ne_top hJ)
  have : IsLocalRing (P ⧸ J) :=
    .of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  have hker : RingHom.ker (algebraMap P (P ⧸ J)) = J := Ideal.mk_ker
  refine FormallySmooth.iff_injective_cotangentComplexBaseChange P (ResidueField P)
    Ideal.Quotient.mk_surjective (by rw [hker]; exact hJfg) ?_
  intro x hx
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hy : y ∈ maximalIdeal P := fun hu ↦ hx (hu.map _)
  rw [RingHom.mem_ker, ← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply,
    ResidueField.algebraMap_eq]
  exact (residue_eq_zero_iff y).mpr hy

/-- Spanning families of an ideal, seen as a module, and generators of the ideal. -/
lemma span_subtype_eq_top_iff {A : Type*} [CommRing A] (K J : Ideal A) (hKJ : K = J)
    {ι : Type*} (g : ι → A) (hg : ∀ i, g i ∈ K) :
    Submodule.span A (Set.range fun i ↦ (⟨g i, hg i⟩ : K)) = ⊤ ↔ Ideal.span (Set.range g) = J := by
  rw [← hKJ, ← (Submodule.map_injective_of_injective K.injective_subtype).eq_iff,
    Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.range_comp]
  rfl

/-- A linear map sending a spanning family to a linearly independent family is injective. -/
private lemma injective_of_span_eq_top_of_linearIndependent {k V W ι : Type*} [CommRing k]
    [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W] (f : V →ₗ[k] W) (v : ι → V)
    (hv : Submodule.span k (Set.range v) = ⊤) (hli : LinearIndependent k (f ∘ v)) :
    Function.Injective f := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨l, rfl⟩ : x ∈ LinearMap.range (Finsupp.linearCombination k v) := by
    rw [Finsupp.range_linearCombination, hv]
    trivial
  rw [Finsupp.apply_linearCombination] at hx
  rw [hli (hx.trans (map_zero _).symm), map_zero]

/-- II.4.10 (i) ⇔ (iii), the **Jacobian criterion** (II.4.14), local form. Let `P = 𝒪_{X,x}`
be a local ring, formally smooth over `R`, with `Ω¹_{P/R}` finite free (e.g. `X` smooth over
`S` at `x`), and `J ⊆ 𝔪_P` a finitely generated ideal (the ideal of `Y` at `x ∈ Y`). Then
`P ⧸ J = 𝒪_{Y,x}` is formally smooth over `R` iff `J` is generated by elements `g₁,…,gₚ` whose
differentials `dgᵢ(x)` are linearly independent in `Ω¹_{X/S}(x) = κ(x) ⊗ Ω¹_{P/R}`. -/
theorem formallySmooth_quotient_iff_exists_linearIndependent [FormallySmooth R P]
    [Module.Free P Ω[P⁄R]] [Module.Finite P Ω[P⁄R]] (J : Ideal P) (hJ : J ≤ maximalIdeal P)
    (hJfg : J.FG) :
    FormallySmooth R (P ⧸ J) ↔ ∃ (p : ℕ) (g : Fin p → P), Ideal.span (Set.range g) = J ∧
      LinearIndependent (ResidueField P) fun i ↦ (1 : ResidueField P) ⊗ₜ[P] D R P (g i) := by
  let : Algebra (P ⧸ J) (ResidueField P) := (Ideal.Quotient.factor hJ).toAlgebra
  have : IsScalarTower P (P ⧸ J) (ResidueField P) := .of_algebraMap_eq fun _ ↦ rfl
  rw [formallySmooth_quotient_iff_injective J hJ hJfg]
  have hker : RingHom.ker (algebraMap P (P ⧸ J)) = J := Ideal.mk_ker
  set K := RingHom.ker (algebraMap P (P ⧸ J))
  set c := cotangentComplexBaseChange R (P ⧸ J) P (ResidueField P)
  have hc (j : K) : c (1 ⊗ₜ j) = (1 : ResidueField P) ⊗ₜ D R P j.1 := by
    rw [cotangentComplexBaseChange_tmul, one_smul]
    rfl
  have : Module.Finite P K := .of_fg (by rw [hker]; exact hJfg)
  constructor
  · intro hinj
    obtain ⟨κ, a, -, hsp, hli⟩ := exists_linearIndependent' (ResidueField P)
      (fun j : K ↦ (1 : ResidueField P) ⊗ₜ[P] j)
    rw [span_range_tmul_one] at hsp
    let b := Module.Basis.mk hli hsp.ge
    have : Finite κ := Module.Finite.finite_basis b
    let e := Finite.equivFin κ
    have hsa : Submodule.span P (Set.range a) = ⊤ :=
      span_eq_top_of_tmul_eq_basis a b fun i ↦ (Module.Basis.mk_apply hli hsp.ge i).symm
    refine ⟨Nat.card κ, fun i ↦ (a (e.symm i)).1, ?_, ?_⟩
    · refine (span_subtype_eq_top_iff K J hker _ fun i ↦ (a (e.symm i)).2).mp ?_
      rw [← hsa, ← e.symm.surjective.range_comp a]
      rfl
    · have hfun : (fun i ↦ (1 : ResidueField P) ⊗ₜ[P] D R P (a (e.symm i)).1) =
          c ∘ ((fun j : K ↦ (1 : ResidueField P) ⊗ₜ[P] j) ∘ a) ∘ e.symm :=
        funext fun i ↦ (hc _).symm
      rw [hfun]
      exact (hli.comp _ e.symm.injective).map' c (LinearMap.ker_eq_bot.mpr hinj)
  · rintro ⟨p, g, hgJ, hli⟩
    have hg (i : Fin p) : g i ∈ K := by
      rw [hker, ← hgJ]
      exact Ideal.subset_span ⟨i, rfl⟩
    let v : Fin p → K := fun i ↦ ⟨g i, hg i⟩
    have hv : Submodule.span P (Set.range v) = ⊤ := (span_subtype_eq_top_iff K J hker g hg).mpr hgJ
    have hsp : Submodule.span (ResidueField P)
        (Set.range fun i ↦ (1 : ResidueField P) ⊗ₜ[P] v i) = ⊤ := by
      have := Submodule.baseChange_span (R := P) (A := ResidueField P) (Set.range v)
      rw [hv, Submodule.baseChange_top, ← Set.range_comp] at this
      exact this.symm
    have hfun : (fun i ↦ (1 : ResidueField P) ⊗ₜ[P] D R P (g i)) =
        c ∘ fun i ↦ (1 : ResidueField P) ⊗ₜ[P] v i :=
      funext fun i ↦ (hc (v i)).symm
    rw [hfun] at hli
    exact injective_of_span_eq_top_of_linearIndependent c _ hsp hli

/-- II.4.12: let `P = 𝒪_{X,x}` with `X` smooth over `S` at `x` (as above), and `F ∈ 𝔪_P`. The
subscheme of zeros of `F` is smooth over `S` at `x` iff `F = 0` in a neighbourhood of `x` (i.e.
in `𝒪_{X,x}`) or `dF(x) ≠ 0` in `Ω¹_{X/S}(x)`. -/
theorem formallySmooth_quotient_span_singleton_iff [FormallySmooth R P]
    [Module.Free P Ω[P⁄R]] [Module.Finite P Ω[P⁄R]] {F : P} (hF : F ∈ maximalIdeal P) :
    FormallySmooth R (P ⧸ Ideal.span {F}) ↔
      F = 0 ∨ (1 : ResidueField P) ⊗ₜ[P] D R P F ≠ 0 := by
  have hle : Ideal.span {F} ≤ maximalIdeal P := (Ideal.span_singleton_le_iff_mem _).mpr hF
  rw [formallySmooth_quotient_iff_exists_linearIndependent _ hle
    (Submodule.fg_span_singleton F)]
  constructor
  · rintro ⟨p, g, hgJ, hli⟩
    by_contra! H
    have hzero (i : Fin p) : (1 : ResidueField P) ⊗ₜ[P] D R P (g i) = 0 := by
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (hgJ ▸ Ideal.subset_span ⟨i, rfl⟩ :
        g i ∈ Ideal.span {F})
      rw [← ha, Derivation.leibniz, tmul_add, tmul_smul, tmul_smul, H.2, smul_zero, zero_add,
        ← algebraMap_smul (ResidueField P) F, ResidueField.algebraMap_eq,
        (residue_eq_zero_iff F).mpr hF, zero_smul]
    have hp : p = 0 := by
      by_contra hp
      exact hli.ne_zero ⟨0, Nat.pos_of_ne_zero hp⟩ (hzero _)
    subst hp
    rw [Set.range_eq_empty, Ideal.span_empty, eq_comm, Ideal.span_singleton_eq_bot] at hgJ
    exact H.1 hgJ
  · rintro (rfl | h)
    · exact ⟨0, ![], by simp, linearIndependent_empty_type⟩
    · refine ⟨1, ![F], by simp, ?_⟩
      rw [linearIndependent_unique_iff]
      simpa using h

end Jacobian

section Descent

open AlgebraicGeometry CategoryTheory Limits

/-- II.4.13, global affine form: if `T` is faithfully flat over `R` and `T ⊗_R S` is smooth over
`T`, then `S` is smooth over `R` (mathlib; the converse is base change). -/
theorem smooth_of_smooth_tensorProduct {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] [Module.FaithfullyFlat R T] [Smooth T (T ⊗[R] S)] :
    Smooth R S :=
  .of_smooth_tensorProduct_of_faithfullyFlat T

/-- II.4.13, global form: for a flat surjective quasi-compact `S' ⟶ S` and `Y' = Y ×_S S'`,
`Y` is smooth over `S` iff `Y'` is smooth over `S'` (mathlib's fpqc descent; SGA does not
assume quasi-compactness). -/
theorem smooth_iff_of_isPullback {Y' S' Y S : Scheme.{u}} {f' : Y' ⟶ S'} {g' : Y' ⟶ Y}
    {g : S' ⟶ S} {f : Y ⟶ S} (h : IsPullback f' g' g f) [Surjective g] [Flat g]
    [QuasiCompact g] : Smooth f' ↔ Smooth f :=
  MorphismProperty.iff_of_isPullback (Q := @Surjective ⊓ @Flat ⊓ @QuasiCompact) h
    ⟨⟨‹_›, ‹_›⟩, ‹_›⟩

end Descent

end SGA.SGA1.ExposeII
