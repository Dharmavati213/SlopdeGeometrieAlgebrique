import SGA.SGA2.ExposeII.Principal
import Mathlib.Algebra.Category.ModuleCat.Injective
import Mathlib.Algebra.Module.LocalizedModule.Basic
import Mathlib.LinearAlgebra.Isomorphisms

/-!
# SGA 2, Exposé II, Corollary 10: injectives and principal localization

An injective module over a noetherian ring surjects onto its localization at
one element. More generally, a uniform bound on the ring's torsion by powers
of that element suffices. The proof extends a map from the principal ideal
generated by a sufficiently high power to the whole ring.
-/

noncomputable section

universe u

open CategoryTheory Limits

namespace SGA.SGA2.ExposeII

variable {R : Type u} [CommRing R]

/-- A linear map to an injective module factors through any linear map
whose kernel it kills. -/
theorem exists_linearMap_extension_of_ker_le
    {A B E : ModuleCat.{u} R} [Injective E]
    (p : A →ₗ[R] B) (q : A →ₗ[R] E) (h : LinearMap.ker p ≤ LinearMap.ker q) :
    ∃ g : B →ₗ[R] E, g.comp p = q := by
  let q' : LinearMap.range p →ₗ[R] E :=
    ((LinearMap.ker p).liftQ q h).comp p.quotKerEquivRange.symm.toLinearMap
  let i : ModuleCat.of R (LinearMap.range p) ⟶ B :=
    ModuleCat.ofHom (LinearMap.range p).subtype
  have : Mono i := (ModuleCat.mono_iff_injective i).mpr Subtype.val_injective
  let g := Injective.factorThru (ModuleCat.ofHom q') i
  refine ⟨g.hom, ?_⟩
  ext a
  have heval : g (p a) = q' (p.rangeRestrict a) :=
    ConcreteCategory.congr_hom (Injective.comp_factorThru (ModuleCat.ofHom q') i)
      (p.rangeRestrict a)
  change g (p a) = q a
  rw [heval]
  change (LinearMap.ker p).liftQ q h
    (p.quotKerEquivRange.symm ⟨p a, ⟨a, rfl⟩⟩) = q a
  exact congrArg ((LinearMap.ker p).liftQ q h)
    (p.quotKerEquivRange_symm_apply_image a ⟨a, rfl⟩)

/-- A uniform bound on principal torsion in the ring permits division
in an injective module after multiplying by that fixed power. -/
theorem exists_pow_smul_eq_of_injective (E : ModuleCat.{u} R) [Injective E]
    (f : R) {c : ℕ}
    (hc : ∀ n : ℕ, ∀ r : R, f ^ n • r = 0 → f ^ c • r = 0)
    (n : ℕ) (x : E) : ∃ y : E, f ^ (n + c) • y = f ^ c • x := by
  let p : R →ₗ[R] R := f ^ (n + c) • LinearMap.id
  let q : R →ₗ[R] E := LinearMap.toSpanSingleton R E (f ^ c • x)
  have hker : LinearMap.ker p ≤ LinearMap.ker q := by
    intro r hr
    have hfr : f ^ c • r = 0 := hc (n + c) r hr
    change r • (f ^ c • x) = 0
    rw [smul_smul, mul_comm, ← smul_eq_mul, hfr, zero_smul]
  obtain ⟨g, hg⟩ := exists_linearMap_extension_of_ker_le
    (A := ModuleCat.of R R) (B := ModuleCat.of R R) p q hker
  refine ⟨g 1, ?_⟩
  have h := congrArg (fun t : R →ₗ[R] E => t 1) hg
  simpa [p, q, ← g.map_smul] using h

/-- The map to a principal localization is surjective for injective
coefficients whenever the ring has bounded torsion by powers of that element. -/
theorem away_mkLinearMap_surjective_of_injective_of_uniform_bound
    (E : ModuleCat.{u} R) [Injective E] (f : R) {c : ℕ}
    (hc : ∀ n : ℕ, ∀ r : R, f ^ n • r = 0 → f ^ c • r = 0) :
    Function.Surjective (LocalizedModule.mkLinearMap (Submonoid.powers f) E) := by
  intro z
  induction z using LocalizedModule.induction_on with
  | h x s =>
    rcases s with ⟨s, ⟨n, rfl⟩⟩
    obtain ⟨y, hy⟩ := exists_pow_smul_eq_of_injective E f hc n x
    refine ⟨y, LocalizedModule.mk_eq.mpr ⟨⟨f ^ c, ⟨c, rfl⟩⟩, ?_⟩⟩
    simpa only [Submonoid.smul_def, Subtype.coe_mk, OneMemClass.coe_one,
      one_smul, smul_smul, ← pow_add, Nat.add_comm c n] using hy

/-- II.10, the principal-localization module argument: over a noetherian
ring, an injective module surjects onto its localization at any element. -/
theorem away_mkLinearMap_surjective_of_injective [IsNoetherianRing R]
    (E : ModuleCat.{u} R) [Injective E] (f : R) :
    Function.Surjective (LocalizedModule.mkLinearMap (Submonoid.powers f) E) := by
  obtain ⟨c, hc⟩ := exists_uniform_pow_smul_eq_zero (M := R) f
  exact away_mkLinearMap_surjective_of_injective_of_uniform_bound E f hc

/-- The principal-localization surjectivity result applies to any model
of localization, including sections of the associated module sheaf. -/
theorem away_localization_surjective_of_injective [IsNoetherianRing R]
    (E : ModuleCat.{u} R) [Injective E] (f : R)
    {N : Type*} [AddCommGroup N] [Module R N] (g : E →ₗ[R] N)
    [IsLocalizedModule.Away f g] : Function.Surjective g := by
  intro y
  obtain ⟨z, rfl⟩ := (IsLocalizedModule.iso (Submonoid.powers f) g).surjective y
  obtain ⟨x, hx⟩ := away_mkLinearMap_surjective_of_injective E f z
  refine ⟨x, ?_⟩
  rw [← hx]
  exact (IsLocalizedModule.iso_mk_one (Submonoid.powers f) g x).symm

end SGA.SGA2.ExposeII
