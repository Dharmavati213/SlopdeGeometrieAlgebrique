import Mathlib.FieldTheory.SeparablyGenerated
import Mathlib.FieldTheory.PrimitiveElement
import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
import Mathlib.RingTheory.Algebraic.Integral
import Mathlib.RingTheory.Polynomial.UniqueFactorization
import Mathlib.Algebra.GCDMonoid.IntegrallyClosed

/-!
# Plane models of function fields of curves

Let `k` be a perfect field and `K` a finitely generated extension of `k` of transcendence degree
`1` (the function field of a curve over `k`). Then `K = k(x, y)` with `x` transcendental over `k`
and `y` integral over `k[x]`, and the relations between `x` and `y` form the principal ideal
generated by the minimal polynomial `f ∈ k[x][t]` of `y` over `k[x]`, a monic irreducible
polynomial (`Field.exists_planeModel_of_trdeg_eq_one`). Geometrically, `f(x, t) = 0` is an affine
plane curve with function field `K`, the plane model of the curve.

The proof: `K / k` is separably generated (`k` perfect,
`exists_isTranscendenceBasis_and_isSeparable_of_perfectField`), so `K` is finite separable over
`k(x)` for a transcendental `x`; a primitive element (`Field.exists_primitive_element`), multiplied
by a suitable nonzero element of `k[x]`, is integral over `k[x]` (`exists_integral_multiple`); since
`k[x]` is integrally closed, its minimal polynomial divides every polynomial vanishing at it
(`minpoly.isIntegrallyClosed_dvd`).

## References

* [R. Hartshorne, *Algebraic Geometry*, I.4.9 and I.4.6][Hartshorne]
* [Stacks Project, Tag 030W](https://stacks.math.columbia.edu/tag/030W) (separably generated)
-/

universe u v

open Polynomial IntermediateField

namespace Field

variable (k : Type u) (K : Type v) [Field k] [Field K] [Algebra k K]

/-- **Plane model of a function field of transcendence degree `1`**: let `k` be perfect and `K`
finitely generated over `k` of transcendence degree `1`. Then there are `x y : K` with `x`
transcendental over `k`, `K = k(x, y)`, and such that the kernel of the evaluation
`k[s][t] → K`, `s ↦ x`, `t ↦ y`, is generated by a monic irreducible polynomial `f` of positive
degree in `t`. -/
theorem exists_planeModel_of_trdeg_eq_one [PerfectField k] [Algebra.EssFiniteType k K]
    (h : Algebra.trdeg k K = 1) :
    ∃ x y : K, Transcendental k x ∧ IntermediateField.adjoin k {x, y} = ⊤ ∧
      ∃ f : (Polynomial k)[X], f.Monic ∧ Irreducible f ∧ 0 < f.natDegree ∧
        RingHom.ker (eval₂RingHom (aeval x).toRingHom y) = Ideal.span {f} := by
  obtain ⟨s, hs, hsep⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField k K
  -- the transcendence basis has a single element
  have hcard : s.card = 1 := by
    have e := hs.cardinalMk_eq_trdeg
    rw [h, Cardinal.mk_coe_finset] at e
    exact_mod_cast e
  obtain ⟨x, rfl⟩ := Finset.card_eq_one.mp hcard
  have hx : Transcendental k x := by
    have := hs.1.transcendental ⟨x, Finset.mem_singleton_self x⟩
    simpa using this
  have hcoe : ((({x} : Finset K)) : Set K) = {x} := Finset.coe_singleton x
  have hr : Set.range ((↑) : ({x} : Finset K) → K) = {x} := by rw [Subtype.range_coe, hcoe]
  set E := IntermediateField.adjoin k ({x} : Set K)
  have hsepE : Algebra.IsSeparable E K := by rw [hcoe] at hsep; exact hsep
  -- `K` is finite over `E = k(x)`
  have halg : Algebra.IsAlgebraic E K := by
    have := hs.isAlgebraic_field
    rw [hr] at this
    exact this
  have : Algebra.EssFiniteType E K := Algebra.EssFiniteType.of_comp k E K
  have : FiniteDimensional E K := Algebra.finite_of_essFiniteType_of_isAlgebraic
  obtain ⟨α, hα⟩ := Field.exists_primitive_element E K
  -- the `k[X]`-algebra structure `X ↦ x` on `K`
  let _ : Algebra k[X] K := (aeval x).toRingHom.toAlgebra
  have halgMap : algebraMap k[X] K = (aeval x).toRingHom := rfl
  have hinj : Function.Injective (algebraMap k[X] K) := transcendental_iff_injective.mp hx
  -- `k[X] ≃ k[x] ⊆ K`
  let e : k[X] ≃ₐ[k] Algebra.adjoin k ({x} : Set K) :=
    (AlgEquiv.ofInjective (aeval x) hinj).trans
      (Subalgebra.equivOfEq _ _ (Algebra.adjoin_singleton_eq_range_aeval k x).symm)
  have he (p : k[X]) : (e p : K) = aeval x p := rfl
  -- `α` is algebraic over `k[X]`
  have hαS : IsAlgebraic (Algebra.adjoin k ({x} : Set K)) α := by
    have := hs.isAlgebraic
    rw [hr] at this
    exact Algebra.IsAlgebraic.isAlgebraic α
  have hα' : IsAlgebraic k[X] α := by
    refine (isAlgebraic_ringHom_iff_of_comp_eq e.symm.toRingEquiv (RingHom.id K)
      Function.injective_id ?_).mpr hαS
    ext q
    obtain ⟨p, rfl⟩ := e.surjective q
    simp [halgMap, he]
  -- a multiple `y = r • α` of the primitive element integral over `k[X]`
  obtain ⟨r, hr0, hrint⟩ := hα'.exists_integral_multiple
  have hrx : aeval x r ≠ 0 := fun h0 ↦ hr0 (hinj (by rw [halgMap]; simpa using h0))
  have hy : r • α = aeval x r * α := Algebra.smul_def r α
  refine ⟨x, r • α, hx, ?_, minpoly k[X] (r • α), minpoly.monic hrint,
    minpoly.irreducible hrint, minpoly.natDegree_pos hrint, ?_⟩
  · have hxα : IntermediateField.adjoin k ({x} ∪ {α} : Set K) = ⊤ := by
      rw [← IntermediateField.adjoin_adjoin_left, hα, IntermediateField.restrictScalars_top]
    rw [eq_top_iff, ← hxα, IntermediateField.adjoin_le_iff]
    rintro z (hz | hz)
    · rw [Set.mem_singleton_iff.mp hz]
      exact IntermediateField.subset_adjoin k _ (Set.mem_insert _ _)
    · rw [Set.mem_singleton_iff.mp hz]
      have hrxm : aeval x r ∈ IntermediateField.adjoin k ({x, r • α} : Set K) :=
        IntermediateField.algebra_adjoin_le_adjoin k _
          (Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))
            (Polynomial.aeval_mem_adjoin_singleton k x))
      have hym : r • α ∈ IntermediateField.adjoin k ({x, r • α} : Set K) :=
        IntermediateField.subset_adjoin k _ (Set.mem_insert_of_mem _ rfl)
      have : α = (aeval x r)⁻¹ * (r • α) := by rw [hy, ← mul_assoc, inv_mul_cancel₀ hrx, one_mul]
      have hmem := mul_mem (inv_mem hrxm) hym
      rwa [← this] at hmem
  · have : FaithfulSMul k[X] K := (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
    ext p
    rw [RingHom.mem_ker, Ideal.mem_span_singleton, ← minpoly.isIntegrallyClosed_dvd_iff hrint]
    rfl

end Field
