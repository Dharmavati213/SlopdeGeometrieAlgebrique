import Mathlib.Topology.Constructible

/-!
# Constructible sets as finite unions of locally closed pieces

In a compact quasi-separated space, a constructible set is a finite union of sets `U ∩ Z` with `U`
a compact open and `Z` a closed set with compact open complement
(`IsConstructible.isFiniteUnionOpenInterClosed`). Constructible sets are the Boolean algebra
generated by the retrocompact open sets (EGA 0_III 9.1.2, mathlib's `Topology.IsConstructible`);
the description proved here is EGA 0_III 9.1.3 (finite unions of sets `U ∩ ∁V` with `U`, `V`
retrocompact open) in a compact quasi-separated space. It is used to reduce limit arguments on
constructible sets to open and closed sets (`SGA.Foundations.Limits.PropertiesLimitSurjective`).

## References

* [EGA 0_III, 9.1.2, 9.1.3][EGA3]
-/

open Set

namespace Topology

variable {X : Type*} [TopologicalSpace X]

/-- `s` is a finite union of sets `U ∩ Z` with `U` a compact open and `Z` a closed set whose
complement is compact. -/
def IsFiniteUnionOpenInterClosed (s : Set X) : Prop :=
  ∃ S : Set (Set X × Set X), S.Finite ∧
    (∀ p ∈ S, IsOpen p.1 ∧ IsCompact p.1 ∧ IsClosed p.2 ∧ IsCompact p.2ᶜ) ∧
      s = ⋃ p ∈ S, p.1 ∩ p.2

namespace IsFiniteUnionOpenInterClosed

lemma union {s t : Set X} (hs : IsFiniteUnionOpenInterClosed s)
    (ht : IsFiniteUnionOpenInterClosed t) : IsFiniteUnionOpenInterClosed (s ∪ t) := by
  obtain ⟨S, hSf, hS, rfl⟩ := hs
  obtain ⟨T, hTf, hT, rfl⟩ := ht
  refine ⟨S ∪ T, hSf.union hTf, fun p hp ↦ hp.elim (hS p) (hT p), ?_⟩
  rw [Set.biUnion_union]

lemma inter [QuasiSeparatedSpace X] {s t : Set X} (hs : IsFiniteUnionOpenInterClosed s)
    (ht : IsFiniteUnionOpenInterClosed t) : IsFiniteUnionOpenInterClosed (s ∩ t) := by
  obtain ⟨S, hSf, hS, rfl⟩ := hs
  obtain ⟨T, hTf, hT, rfl⟩ := ht
  refine ⟨Set.image2 (fun p q ↦ (p.1 ∩ q.1, p.2 ∩ q.2)) S T, hSf.image2 _ hTf, ?_, ?_⟩
  · rintro _ ⟨p, hp, q, hq, rfl⟩
    obtain ⟨h1, h2, h3, h4⟩ := hS p hp
    obtain ⟨h1', h2', h3', h4'⟩ := hT q hq
    refine ⟨h1.inter h1', QuasiSeparatedSpace.inter_isCompact _ _ h1 h2 h1' h2', h3.inter h3', ?_⟩
    rw [Set.compl_inter]
    exact h4.union h4'
  · ext x
    simp only [Set.mem_inter_iff, Set.mem_iUnion, Set.mem_image2, exists_prop]
    constructor
    · rintro ⟨⟨p, hp, hx1, hx2⟩, ⟨q, hq, hy1, hy2⟩⟩
      exact ⟨_, ⟨p, hp, q, hq, rfl⟩, ⟨hx1, hy1⟩, hx2, hy2⟩
    · rintro ⟨_, ⟨p, hp, q, hq, rfl⟩, ⟨hx1, hy1⟩, hx2, hy2⟩
      exact ⟨⟨p, hp, hx1, hx2⟩, ⟨q, hq, hy1, hy2⟩⟩

lemma univ [CompactSpace X] : IsFiniteUnionOpenInterClosed (Set.univ : Set X) :=
  ⟨{(Set.univ, Set.univ)}, Set.finite_singleton _, by
    rintro p rfl
    exact ⟨isOpen_univ, isCompact_univ, isClosed_univ, by simp⟩, by simp⟩

lemma of_isOpen [CompactSpace X] {U : Set X} (hU : IsOpen U) (hUc : IsCompact U) :
    IsFiniteUnionOpenInterClosed U :=
  ⟨{(U, Set.univ)}, Set.finite_singleton _, by
    rintro p rfl
    exact ⟨hU, hUc, isClosed_univ, by simp⟩, by simp⟩

lemma of_isClosed [CompactSpace X] {Z : Set X} (hZ : IsClosed Z) (hZc : IsCompact Zᶜ) :
    IsFiniteUnionOpenInterClosed Z :=
  ⟨{(Set.univ, Z)}, Set.finite_singleton _, by
    rintro p rfl
    exact ⟨isOpen_univ, isCompact_univ, hZ, hZc⟩, by simp⟩

lemma biInter [CompactSpace X] [QuasiSeparatedSpace X] {ι : Type*} {S : Set ι} (hS : S.Finite)
    {f : ι → Set X} (hf : ∀ i ∈ S, IsFiniteUnionOpenInterClosed (f i)) :
    IsFiniteUnionOpenInterClosed (⋂ i ∈ S, f i) := by
  induction S, hS using Set.Finite.induction_on with
  | empty => simpa using univ
  | @insert a S _ _ ih =>
    rw [Set.biInter_insert]
    exact (hf a (Set.mem_insert _ _)).inter (ih fun i hi ↦ hf i (Set.mem_insert_of_mem _ hi))

lemma compl [CompactSpace X] [QuasiSeparatedSpace X] {s : Set X}
    (hs : IsFiniteUnionOpenInterClosed s) : IsFiniteUnionOpenInterClosed sᶜ := by
  obtain ⟨S, hSf, hS, rfl⟩ := hs
  rw [Set.compl_iUnion₂]
  refine biInter hSf fun p hp ↦ ?_
  obtain ⟨h1, h2, h3, h4⟩ := hS p hp
  rw [Set.compl_inter]
  exact (of_isClosed h1.isClosed_compl (by simpa using h2)).union (of_isOpen h3.isOpen_compl h4)

end IsFiniteUnionOpenInterClosed

/-- In a compact quasi-separated space, a constructible set is a finite union of sets `U ∩ Z` with
`U` a compact open and `Z` a closed set with compact complement. -/
theorem IsConstructible.isFiniteUnionOpenInterClosed [CompactSpace X]
    [QuasiSeparatedSpace X] {s : Set X} (hs : IsConstructible s) :
    IsFiniteUnionOpenInterClosed s := by
  induction hs using IsConstructible.empty_union_induction with
  | open_retrocompact U hU hUc => exact .of_isOpen hU hUc.isCompact
  | union s _ t _ hs ht => exact hs.union ht
  | compl s _ hs => exact hs.compl

end Topology
