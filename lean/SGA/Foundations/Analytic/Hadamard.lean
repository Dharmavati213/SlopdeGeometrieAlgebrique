import SGA.Foundations.Analytic.Completion
import SGA.Foundations.Analytic.Stalk

/-!
# Hadamard's lemma for analytic functions

If `h` is analytic at `c ∈ 𝕜ⁿ`, then near `(c, c)` one can write
`h(a) - h(b) = ∑ⱼ (aⱼ - bⱼ) Hⱼ(a, b)` with `Hⱼ` analytic (`exists_hadamard`). The proof: the
convergent series of `(d, b) ↦ h(c + d + b) - h(c + b)` vanishes on `d = 0`, hence lies in the ideal
generated by the variables `d` (divide by the first variable, `MvPowerSeries.divX`).

This is what makes morphisms into local models depend only on the classes of their components
([Grauert–Remmert, *Coherent analytic sheaves*, §1.3]).
-/

open scoped NNReal ENNReal Topology
open Filter MvPowerSeries

noncomputable section

namespace MvPowerSeries

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜] {n : ℕ}

/-- The restriction of a series in the variables `(d, b) ∈ 𝕜ⁿ × 𝕜ⁿ` (indexed by `Fin (n + n)`)
to the subspace `d = 0`. -/
def restrictRight (f : MvPowerSeries (Fin (n + n)) 𝕜) : MvPowerSeries (Fin n) 𝕜 :=
  fun β ↦ coeff (Finsupp.embDomain (Fin.natAddEmb n) β) f

lemma coeff_restrictRight (f : MvPowerSeries (Fin (n + n)) 𝕜) (β : Fin n →₀ ℕ) :
    coeff β (restrictRight f) = coeff (Finsupp.embDomain (Fin.natAddEmb n) β) f := rfl

lemma monomialEval_append_zero (b : Fin n → 𝕜) (α : Fin (n + n) →₀ ℕ)
    (h : monomialEval (Fin.append (0 : Fin n → 𝕜) b) α ≠ 0) :
    ∀ i, α (Fin.castAdd n i) = 0 := by
  intro i
  by_contra hi
  apply h
  rw [monomialEval, Finsupp.prod]
  refine Finset.prod_eq_zero (i := Fin.castAdd n i) (Finsupp.mem_support_iff.mpr hi) ?_
  rw [Fin.append_left, Pi.zero_apply, zero_pow hi]

lemma eq_embDomain_of_castAdd_eq_zero (α : Fin (n + n) →₀ ℕ) (h : ∀ i, α (Fin.castAdd n i) = 0) :
    α = Finsupp.embDomain (Fin.natAddEmb n)
      (Finsupp.equivFunOnFinite.symm fun i ↦ α (Fin.natAdd n i)) := by
  ext j
  refine Fin.addCases (fun i ↦ ?_) (fun i ↦ ?_) j
  · rw [h i, Finsupp.embDomain_of_notMem_range]
    rintro ⟨k, hk⟩
    have := congrArg Fin.val hk
    simp only [Fin.natAddEmb_apply, Fin.val_natAdd, Fin.val_castAdd] at this
    omega
  · rw [show Fin.natAdd n i = Fin.natAddEmb n i from rfl, Finsupp.embDomain_apply_self]
    simp

lemma tsumEval_restrictRight (f : MvPowerSeries (Fin (n + n)) 𝕜) (b : Fin n → 𝕜) :
    tsumEval (restrictRight f) b = tsumEval f (Fin.append (0 : Fin n → 𝕜) b) := by
  rw [tsumEval, tsumEval, ← (Finsupp.embDomain_injective (Fin.natAddEmb n)).tsum_eq]
  · refine tsum_congr fun β ↦ ?_
    rw [coeff_restrictRight, monomialEval, monomialEval, Finsupp.prod_embDomain]
    congr 1
    refine Finset.prod_congr rfl fun i _ ↦ ?_
    dsimp only
    rw [show Fin.natAddEmb n i = Fin.natAdd n i from rfl, Fin.append_right]
  · intro α hα
    have h : monomialEval (Fin.append (0 : Fin n → 𝕜) b) α ≠ 0 := fun h0 ↦ hα (by
      simp only [h0, mul_zero])
    exact ⟨_, (eq_embDomain_of_castAdd_eq_zero α (monomialEval_append_zero b α h)).symm⟩

lemma restrictRight_mem_convergent {f : MvPowerSeries (Fin (n + n)) 𝕜}
    (hf : f ∈ convergent _ 𝕜) : restrictRight f ∈ convergent (Fin n) 𝕜 := by
  obtain ⟨ρ, hρ, hfin⟩ := hf
  refine ⟨fun i ↦ ρ (Fin.natAdd n i), fun i ↦ hρ _, ne_top_of_le_ne_top hfin ?_⟩
  refine le_trans (le_of_eq ?_) (ENNReal.tsum_comp_le_tsum_of_injective
    (Finsupp.embDomain_injective (Fin.natAddEmb n))
    fun α ↦ ((‖coeff α f‖₊ * monomialEval ρ α : ℝ≥0) : ℝ≥0∞))
  refine tsum_congr fun β ↦ ?_
  rw [coeff_restrictRight, monomialEval, monomialEval, Finsupp.prod_embDomain]
  rfl

lemma eventually_tsumEval_sum_mul {σ : Type*} [Finite σ] [CompleteSpace 𝕜] {ι : Type*}
    (s : Finset ι) (p q : ι → MvPowerSeries σ 𝕜)
    (hp : ∀ i, p i ∈ convergent σ 𝕜) (hq : ∀ i, q i ∈ convergent σ 𝕜) :
    ∀ᶠ w in 𝓝 (0 : σ → 𝕜), tsumEval (∑ i ∈ s, p i * q i) w =
      ∑ i ∈ s, tsumEval (p i) w * tsumEval (q i) w := by
  classical
  induction s using Finset.induction_on with
  | empty => exact Eventually.of_forall fun w ↦ by simp [tsumEval]
  | insert j s hj ih =>
    have hs : ∑ i ∈ s, p i * q i ∈ convergent σ 𝕜 :=
      Subalgebra.sum_mem _ fun i _ ↦ mul_mem (hp i) (hq i)
    filter_upwards [ih, eventually_tsumEval_add_mul (mul_mem (hp j) (hq j)) hs,
      eventually_tsumEval_add_mul (hp j) (hq j)] with w h₁ h₂ h₃
    rw [Finset.sum_insert hj, Finset.sum_insert hj, h₂.1, h₃.2, h₁]

end MvPowerSeries

namespace AnalyticGeometry

variable {𝕜 : Type} [NontriviallyNormedField 𝕜] [CompleteSpace 𝕜] {n : ℕ}

/-- The auxiliary function `(d, b) ↦ h(c + d + b) - h(c + b)`. -/
def hadamardAux (h : (Fin n → 𝕜) → 𝕜) (c : Fin n → 𝕜) (w : Fin (n + n) → 𝕜) : 𝕜 :=
  h (c + (fun i ↦ w (Fin.castAdd n i)) + fun i ↦ w (Fin.natAdd n i)) -
    h (c + fun i ↦ w (Fin.natAdd n i))

omit [CompleteSpace 𝕜] in
lemma analyticAt_castAdd_part (x : Fin (n + n) → 𝕜) :
    AnalyticAt 𝕜 (fun w : Fin (n + n) → 𝕜 ↦ fun i ↦ w (Fin.castAdd n i)) x :=
  AnalyticAt.pi fun i ↦ analyticAt_apply (Fin.castAdd n i) x

omit [CompleteSpace 𝕜] in
lemma analyticAt_natAdd_part (x : Fin (n + n) → 𝕜) :
    AnalyticAt 𝕜 (fun w : Fin (n + n) → 𝕜 ↦ fun i ↦ w (Fin.natAdd n i)) x :=
  AnalyticAt.pi fun i ↦ analyticAt_apply (Fin.natAdd n i) x

omit [CompleteSpace 𝕜] in
lemma analyticAt_hadamardAux {h : (Fin n → 𝕜) → 𝕜} {c : Fin n → 𝕜} (hh : AnalyticAt 𝕜 h c) :
    AnalyticAt 𝕜 (hadamardAux h c) 0 := by
  refine AnalyticAt.sub ?_ ?_
  · exact hh.comp_of_eq (((analyticAt_const (v := c)).add
      (analyticAt_castAdd_part 0)).add (analyticAt_natAdd_part 0)) (by ext; simp)
  · exact hh.comp_of_eq ((analyticAt_const (v := c)).add (analyticAt_natAdd_part 0))
      (by ext; simp)

omit [CompleteSpace 𝕜] in
lemma hadamardAux_append_zero (h : (Fin n → 𝕜) → 𝕜) (c b : Fin n → 𝕜) :
    hadamardAux h c (Fin.append (0 : Fin n → 𝕜) b) = 0 := by
  simp only [hadamardAux, Fin.append_left, Fin.append_right]
  have h₁ : (fun i : Fin n ↦ (0 : Fin n → 𝕜) i) = 0 := rfl
  have h₂ : (fun i : Fin n ↦ b i) = b := rfl
  rw [h₁, h₂, add_zero, sub_self]

omit [CompleteSpace 𝕜] in
lemma continuous_append_zero :
    Continuous (fun b : Fin n → 𝕜 ↦ Fin.append (0 : Fin n → 𝕜) b) :=
  continuous_pi fun j ↦ Fin.addCases
    (motive := fun j ↦ Continuous fun b : Fin n → 𝕜 ↦ Fin.append (0 : Fin n → 𝕜) b j)
    (fun i ↦ by simp only [Fin.append_left]; exact continuous_const)
    (fun i ↦ by simp only [Fin.append_right]; exact continuous_apply i) j

omit [CompleteSpace 𝕜] in
lemma append_zero_zero : Fin.append (0 : Fin n → 𝕜) (0 : Fin n → 𝕜) = 0 := by
  funext j
  refine Fin.addCases (fun i ↦ ?_) (fun i ↦ ?_) j
  · rw [Fin.append_left]; rfl
  · rw [Fin.append_right]; rfl

/-- The series of `(d, b) ↦ h(c + d + b) - h(c + b)` is a combination of the variables `d`. -/
lemma taylorSeries_hadamardAux_eq {h : (Fin n → 𝕜) → 𝕜} {c : Fin n → 𝕜}
    (hh : AnalyticAt 𝕜 h c) :
    taylorSeries (hadamardAux h c) =
      ∑ i : Fin n, X (Fin.castAdd n i) *
        divX (Fin.castAdd n i) (taylorSeries (hadamardAux h c)) := by
  set f := taylorSeries (hadamardAux h c)
  have hf : f ∈ convergent _ 𝕜 := taylorSeries_mem_convergent _
  have hFf := eventuallyEq_tsumEval_taylorSeries (analyticAt_hadamardAux hh)
  have hr : restrictRight f = 0 := by
    refine eq_zero_of_tsumEval_eventuallyEq_zero (restrictRight_mem_convergent hf) ?_
    have hι : Tendsto (fun b : Fin n → 𝕜 ↦ Fin.append (0 : Fin n → 𝕜) b) (𝓝 0) (𝓝 0) := by
      have := continuous_append_zero.tendsto (0 : Fin n → 𝕜)
      rwa [append_zero_zero] at this
    filter_upwards [hι.eventually hFf] with b hb
    rw [tsumEval_restrictRight, ← hb, hadamardAux_append_zero, Pi.zero_apply]
  have hC : ∀ α, (∀ i, α (Fin.castAdd n i) = 0) → coeff α f = 0 := fun α hα ↦ by
    rw [eq_embDomain_of_castAdd_eq_zero α hα, ← coeff_restrictRight, hr, map_zero]
  have h0 : constantCoeff f = 0 := by
    rw [← coeff_zero_eq_constantCoeff_apply]
    exact hC 0 fun _ ↦ rfl
  have hnat : ∀ i, divX (Fin.natAdd n i) f = 0 := fun i ↦ by
    ext α
    rw [coeff_divX, map_zero]
    split_ifs with hα
    · refine hC _ fun l ↦ ?_
      rw [Finsupp.add_apply, Finsupp.single_apply, ite_eq_right (fun e ↦ ?_)]
      · by_contra hl
        have := hα _ (Finsupp.mem_support_iff.mpr hl)
        rw [Fin.le_def, Fin.val_natAdd, Fin.val_castAdd] at this
        omega
      · have := congrArg Fin.val e
        simp only [Fin.val_natAdd, Fin.val_castAdd] at this
        omega
    · rfl
  conv_lhs => rw [← sum_X_mul_divX h0]
  rw [Fin.sum_univ_add, Finset.sum_eq_zero (s := Finset.univ)
    (f := fun i : Fin n ↦ X (Fin.natAdd n i) * divX (Fin.natAdd n i) f)
    (fun i _ ↦ by rw [hnat i, mul_zero]), add_zero]

/-- **Hadamard's lemma**: if `h` is analytic at `c ∈ 𝕜ⁿ`, then near `(c, c)`,
`h(a) - h(b) = ∑ⱼ (aⱼ - bⱼ) Hⱼ(a, b)` with `Hⱼ` analytic at `(c, c)`. -/
theorem exists_hadamard (h : (Fin n → 𝕜) → 𝕜) {c : Fin n → 𝕜} (hh : AnalyticAt 𝕜 h c) :
    ∃ H : Fin n → (Fin n → 𝕜) × (Fin n → 𝕜) → 𝕜, (∀ j, AnalyticAt 𝕜 (H j) (c, c)) ∧
      ∀ᶠ p in 𝓝 (c, c), h p.1 - h p.2 = ∑ j, (p.1 j - p.2 j) * H j p := by
  classical
  set f := taylorSeries (hadamardAux h c)
  have hf : f ∈ convergent _ 𝕜 := taylorSeries_mem_convergent _
  set G : Fin n → MvPowerSeries (Fin (n + n)) 𝕜 := fun i ↦ divX (Fin.castAdd n i) f
  have hG : ∀ i, G i ∈ convergent _ 𝕜 := fun i ↦ divX_mem_convergent _ hf
  have hsum : ∀ᶠ w in 𝓝 (0 : Fin (n + n) → 𝕜),
      hadamardAux h c w = ∑ i, w (Fin.castAdd n i) * tsumEval (G i) w := by
    filter_upwards [eventuallyEq_tsumEval_taylorSeries (analyticAt_hadamardAux hh),
      eventually_tsumEval_sum_mul Finset.univ (fun i ↦ X (Fin.castAdd n i)) G
        (fun i ↦ X_mem_convergent _) hG] with w h₁ h₂
    have hdec : f = ∑ i, X (Fin.castAdd n i) * G i := taylorSeries_hadamardAux_eq hh
    rw [h₁]
    change tsumEval f w = _
    rw [hdec, h₂]
    simp only [tsumEval_X]
  -- the encoding `(a, b) ↦ (a - b, b - c)`
  let enc : (Fin n → 𝕜) × (Fin n → 𝕜) → Fin (n + n) → 𝕜 := fun p ↦ Fin.append (p.1 - p.2) (p.2 - c)
  have henc : AnalyticAt 𝕜 enc (c, c) := by
    refine AnalyticAt.pi (f := fun j p ↦ enc p j) fun j ↦ ?_
    refine Fin.addCases (motive := fun j ↦ AnalyticAt 𝕜 (fun p ↦ enc p j) (c, c))
      (fun i ↦ ?_) (fun i ↦ ?_) j
    · simp only [enc, Fin.append_left]
      exact ((analyticAt_apply i _).comp analyticAt_fst).sub
        ((analyticAt_apply i _).comp analyticAt_snd)
    · simp only [enc, Fin.append_right]
      exact ((analyticAt_apply i _).comp analyticAt_snd).sub analyticAt_const
  have henc0 : enc (c, c) = 0 := by
    simp only [enc, sub_self]
    exact append_zero_zero
  refine ⟨fun j p ↦ tsumEval (G j) (enc p), fun j ↦ ?_, ?_⟩
  · exact (analyticAt_tsumEval (hG j)).comp_of_eq henc henc0
  · have htend : Tendsto enc (𝓝 (c, c)) (𝓝 0) := by
      simpa [henc0] using henc.continuousAt.tendsto
    filter_upwards [htend.eventually hsum] with p hp
    have e₁ : hadamardAux h c (enc p) = h p.1 - h p.2 := by
      simp only [hadamardAux, enc, Fin.append_left, Fin.append_right]
      congr 1
      · congr 1
        funext i
        simp only [Pi.add_apply, Pi.sub_apply]
        ring
      · congr 1
        funext i
        simp only [Pi.add_apply, Pi.sub_apply]
        ring
    rw [← e₁, hp]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    simp only [enc, Fin.append_left, Pi.sub_apply]

end AnalyticGeometry
