import Mathlib.AlgebraicGeometry.FunctionField
import Mathlib.RingTheory.Localization.NumDen
import SGA.Foundations.Picard.Basic

/-!
# The line bundle of the pole divisor of a rational function

Let `X` be an integral locally noetherian scheme whose local rings are factorial (for instance a
scheme smooth over a field: regular local rings are factorial by Auslander–Buchsbaum,
`IsRegularLocalRing.uniqueFactorizationMonoid`), and `f` a rational function on `X`. The
denominators of `f` at a point `x`, the `c ∈ 𝒪_{X,x}` with `c f ∈ 𝒪_{X,x}`, form a principal ideal
(generated by the denominator of a reduced fraction for `f`), and these generators are the local
equations of an effective Cartier divisor, the divisor of poles `div_∞ f`. The line bundle
`𝒪(div_∞ f)` has the section `f`, which vanishes exactly at the zeros of `f` where `f` is
regular.

## Main definitions and results

* `IsFractionRing.denIdeal R f`: the ideal of denominators `{c | c f ∈ R}` of `f ∈ Frac R`;
  `IsFractionRing.denIdeal_eq_span_den`: over a factorial domain it is generated by the
  denominator of a reduced fraction; `IsFractionRing.map_denIdeal`: it commutes with
  localization.
* `AlgebraicGeometry.Scheme.exists_section_of_forall_regular`: on an integral scheme, a rational
  function regular at every point of an open `U` is a section over `U`;
  `AlgebraicGeometry.Scheme.exists_unit_of_forall_regular`: if moreover its inverse is regular on
  `U`, it is a unit over `U`.
* `AlgebraicGeometry.Scheme.exists_lineBundle_poleDivisor`: the line bundle `𝒪(div_∞ f)` and its
  section `f`.

## References

* [R. Hartshorne, *Algebraic geometry*, II.6.11][hartshorne1977]
* [Stacks Project, Tag 0BCH](https://stacks.math.columbia.edu/tag/0BCH)
-/

universe u

open CategoryTheory TopologicalSpace Opposite

namespace IsFractionRing

section DenIdeal

variable (R : Type*) [CommRing R] {K : Type*} [Field K] [Algebra R K]

/-- The ideal of denominators `{c ∈ R | c f ∈ R}` of an element `f` of an `R`-algebra `K`. -/
def denIdeal (f : K) : Ideal R where
  carrier := {c | IsLocalization.IsInteger R (algebraMap R K c * f)}
  add_mem' {a b} ha hb := by
    simp only [Set.mem_ofPred_eq, map_add, add_mul] at ha hb ⊢
    exact IsLocalization.isInteger_add ha hb
  zero_mem' := by
    simp only [Set.mem_ofPred_eq, map_zero, zero_mul]
    exact IsLocalization.isInteger_zero
  smul_mem' a b hb := by
    simp only [Set.mem_ofPred_eq, smul_eq_mul, map_mul, mul_assoc] at hb ⊢
    simpa only [Algebra.smul_def] using IsLocalization.isInteger_smul (a := a) hb

variable {R}

lemma mem_denIdeal {f : K} {c : R} :
    c ∈ denIdeal R f ↔ IsLocalization.IsInteger R (algebraMap R K c * f) :=
  Iff.rfl

lemma one_mem_denIdeal_iff {f : K} : (1 : R) ∈ denIdeal R f ↔ IsLocalization.IsInteger R f := by
  rw [mem_denIdeal, map_one, one_mul]

variable [IsDomain R] [UniqueFactorizationMonoid R] [IsFractionRing R K]

/-- Over a factorial domain, the ideal of denominators of `f` is generated by the denominator of a
reduced fraction for `f`. -/
theorem denIdeal_eq_span_den (f : K) : denIdeal R f = Ideal.span {(den R f : R)} := by
  ext c
  rw [mem_denIdeal, Ideal.mem_span_singleton]
  have hf := mk'_num_den' R f
  have hred := num_den_reduced R f
  have hd : algebraMap R K (den R f : R) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (den R f).2
  set n := num R f
  set d := (den R f : R)
  constructor
  · rintro ⟨r, hr⟩
    -- `c · n = r · d`
    have h : c * n = r * d := by
      apply IsFractionRing.injective R K
      rw [map_mul, map_mul, hr, ← hf]
      field_simp
    exact hred.symm.dvd_of_dvd_mul_right ⟨r, by rw [h, mul_comm]⟩
  · rintro ⟨r, rfl⟩
    refine ⟨r * n, ?_⟩
    rw [← hf, map_mul, map_mul]
    field_simp

end DenIdeal

section Localization

variable {R S K : Type*} [CommRing R] [CommRing S] [Algebra R S] (M : Submonoid R)
  [IsLocalization M S] [Field K] [Algebra R K] [Algebra S K] [IsScalarTower R S K]

include M in
/-- The ideal of denominators commutes with localization. -/
theorem map_denIdeal (f : K) :
    (denIdeal R f).map (algebraMap R S) = denIdeal S f := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    rintro c ⟨r, hr⟩
    refine ⟨algebraMap R S r, ?_⟩
    rw [← IsScalarTower.algebraMap_apply, hr, ← IsScalarTower.algebraMap_apply]
  · rintro c ⟨t, ht⟩
    obtain ⟨⟨c₀, m₀⟩, rfl⟩ := IsLocalization.mk'_surjective M c
    obtain ⟨⟨t₀, m₁⟩, rfl⟩ := IsLocalization.mk'_surjective M t
    have hc : algebraMap S K (IsLocalization.mk' S c₀ m₀) * algebraMap R K m₀ =
        algebraMap R K c₀ := by
      rw [IsScalarTower.algebraMap_apply R S K m₀, IsScalarTower.algebraMap_apply R S K c₀,
        ← map_mul, IsLocalization.mk'_spec]
    have ht' : algebraMap S K (IsLocalization.mk' S t₀ m₁) * algebraMap R K m₁ =
        algebraMap R K t₀ := by
      rw [IsScalarTower.algebraMap_apply R S K m₁, IsScalarTower.algebraMap_apply R S K t₀,
        ← map_mul, IsLocalization.mk'_spec]
    dsimp only at ht
    have hmem : (m₁ : R) * c₀ ∈ denIdeal R f := by
      refine ⟨m₀ * t₀, ?_⟩
      rw [map_mul, map_mul, ← hc, ← ht', ht]
      ring
    have e : IsLocalization.mk' S c₀ m₀ =
        algebraMap R S ((m₁ : R) * c₀) * IsLocalization.mk' S (1 : R) (m₁ * m₀) := by
      rw [← IsLocalization.mk'_eq_mul_mk'_one, mul_comm (m₁ : R), mul_comm m₁,
        IsLocalization.mk'_cancel]
    dsimp only
    rw [e]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hmem)

/-- If a finitely generated ideal `J` becomes contained in `(b)` after localization at `M`, it is
already contained in `(b)` after inverting a single element of `M`. -/
theorem exists_mul_mem_span_of_map_le [IsNoetherianRing R] {J : Ideal R} {b : R}
    (h : J.map (algebraMap R S) ≤ Ideal.span {algebraMap R S b}) :
    ∃ m ∈ M, ∀ j ∈ J, m * j ∈ Ideal.span {b} := by
  classical
  have hgen (j : R) (hj : j ∈ J) : ∃ m ∈ M, m * j ∈ Ideal.span {b} := by
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.1 (h (Ideal.mem_map_of_mem _ hj))
    obtain ⟨⟨r, m⟩, rfl⟩ := IsLocalization.mk'_surjective M y
    dsimp only at hy
    have : algebraMap R S (m * j) = algebraMap R S (r * b) := by
      rw [map_mul, ← hy, ← mul_assoc, mul_comm (algebraMap R S (m : R)), mul_assoc,
        ← mul_assoc, IsLocalization.mk'_spec, map_mul]
    obtain ⟨m', hm'⟩ := (IsLocalization.eq_iff_exists M S).1 this
    refine ⟨m' * m, mul_mem m'.2 m.2, Ideal.mem_span_singleton'.2 ⟨m' * r, ?_⟩⟩
    linear_combination -hm'
  obtain ⟨t, ht⟩ := (IsNoetherian.noetherian J)
  choose! n hnM hn using hgen
  refine ⟨∏ x ∈ t, n x, prod_mem fun x hx ↦ hnM x (ht ▸ Ideal.subset_span hx), fun j hj ↦ ?_⟩
  rw [← ht] at hj
  induction hj using Submodule.span_induction with
  | mem x hx =>
    rw [← Finset.mul_prod_erase t n hx, mul_comm (n x), mul_assoc]
    exact Ideal.mul_mem_left _ _ (hn x (ht ▸ Ideal.subset_span hx))
  | zero => simp
  | add x y _ _ hx hy => rw [mul_add]; exact Ideal.add_mem _ hx hy
  | smul a x _ hx => rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ _ hx

end Localization

end IsFractionRing

namespace AlgebraicGeometry.Scheme

variable {X : Scheme.{u}} [IsIntegral X]

/-- On an integral scheme, a rational function `a` which is regular at every point of an open `U`
(i.e. lies in the image of every local ring `𝒪_{X,x}`, `x ∈ U`) is a section over `U`. -/
lemma exists_section_of_forall_regular (U : X.Opens) (a : X.functionField)
    (h : ∀ x ∈ U, ∃ g : X.presheaf.stalk x, algebraMap _ X.functionField g = a) :
    ∃ s : Γ(X, U), ∀ x (hx : x ∈ U),
      algebraMap _ X.functionField (X.presheaf.germ U x hx s) = a := by
  choose g hg using h
  choose V hxV t ht using fun x : U ↦ X.presheaf.exists_germ_eq (g x.1 x.2)
  have hV (x : U) : Nonempty (V x) := ⟨⟨x.1, hxV x⟩⟩
  -- the image of `t x` in the function field is `a`
  have hta (x : U) : X.germToFunctionField (V x) (t x) = a := by
    rw [← algebraMap_germ_eq_germToFunctionField X (hxV x), ht, hg]
  have hgerm (x : U) (w : X) (hw : w ∈ V x) :
      algebraMap _ X.functionField (X.presheaf.germ (V x) w hw (t x)) = a := by
    rw [algebraMap_germ_eq_germToFunctionField, hta]
  obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf (fun x : U ↦ V x ⊓ U) U
    (fun x ↦ homOfLE inf_le_right) (fun x hx ↦ Opens.mem_iSup.2 ⟨⟨x, hx⟩, hxV _, hx⟩)
    (fun x ↦ X.presheaf.map (homOfLE inf_le_left).op (t x)) fun x y ↦ by
      refine TopCat.Presheaf.section_ext X.sheaf _ _ _ fun w hw ↦
        IsFractionRing.injective (X.presheaf.stalk w) X.functionField ?_
      change algebraMap _ _ (X.presheaf.germ _ w hw (X.presheaf.map _
          (X.presheaf.map _ (t x)))) =
        algebraMap _ _ (X.presheaf.germ _ w hw (X.presheaf.map _ (X.presheaf.map _ (t y))))
      simp only [TopCat.Presheaf.germ_res_apply]
      rw [hgerm x w (hw.1.1), hgerm y w hw.2.1]
  refine ⟨s, fun x hx ↦ ?_⟩
  have hmem : x ∈ V ⟨x, hx⟩ ⊓ U := ⟨hxV _, hx⟩
  have e₁ : X.presheaf.germ U x hx s = X.presheaf.germ (V ⟨x, hx⟩ ⊓ U) x hmem
      (X.presheaf.map (homOfLE inf_le_right).op s) :=
    (X.presheaf.germ_res_apply _ _ _ s).symm
  have e₂ : X.presheaf.map (homOfLE (inf_le_right : V ⟨x, hx⟩ ⊓ U ≤ U)).op s =
      X.presheaf.map (homOfLE inf_le_left).op (t ⟨x, hx⟩) := hs ⟨x, hx⟩
  rw [e₁, e₂, TopCat.Presheaf.germ_res_apply, hgerm]

/-- On an integral scheme, a nonzero rational function `a` which is regular at every point of `U`
together with its inverse is a unit of `Γ(X, U)`. -/
lemma exists_unit_of_forall_regular (U : X.Opens) (a : X.functionField) (ha : a ≠ 0)
    (h : ∀ x ∈ U, ∃ g : X.presheaf.stalk x, algebraMap _ X.functionField g = a)
    (h' : ∀ x ∈ U, ∃ g : X.presheaf.stalk x, algebraMap _ X.functionField g = a⁻¹) :
    ∃ u : (Γ(X, U))ˣ, ∀ x (hx : x ∈ U),
      algebraMap _ X.functionField (X.presheaf.germ U x hx u) = a := by
  obtain ⟨s, hs⟩ := exists_section_of_forall_regular U a h
  obtain ⟨t, ht⟩ := exists_section_of_forall_regular U a⁻¹ h'
  have hst : s * t = 1 := TopCat.Presheaf.section_ext X.sheaf _ _ _ fun x hx ↦
    IsFractionRing.injective (X.presheaf.stalk x) X.functionField (by
      change algebraMap _ _ (X.presheaf.germ U x hx (s * t)) =
        algebraMap _ _ (X.presheaf.germ U x hx 1)
      rw [map_mul, map_mul, hs, ht, mul_inv_cancel₀ ha, map_one, map_one])
  exact ⟨⟨s, t, hst, by rw [mul_comm, hst]⟩, hs⟩

section PoleDivisor

variable [IsLocallyNoetherian X] (f : X.functionField)

/-- On an integral locally noetherian scheme with factorial local rings, every point `z` has an
open neighbourhood `W` and `b ∈ Γ(X, W)` whose germ generates the ideal of denominators of the
rational function `f` at every point of `W`. -/
theorem exists_denIdeal_eq_span_germ
    (hUFD : ∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)) (z : X) :
    ∃ (W : X.Opens) (_ : z ∈ W) (b : Γ(X, W)), ∀ (w : X) (hw : w ∈ W),
      IsFractionRing.denIdeal (X.presheaf.stalk w) f =
        Ideal.span {X.presheaf.germ W w hw b} := by
  obtain ⟨_, ⟨W₀, hW₀, rfl⟩, hz, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
  replace hW₀ : IsAffineOpen W₀ := hW₀
  have : Nonempty W₀ := ⟨⟨z, hz⟩⟩
  have : IsNoetherianRing Γ(X, W₀) := IsLocallyNoetherian.component_noetherian ⟨W₀, hW₀⟩
  have : IsFractionRing Γ(X, W₀) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X W₀ hW₀
  set J := IsFractionRing.denIdeal Γ(X, W₀) f
  -- at every point of `W₀`, the ideal of denominators is the localization of `J`
  have hmap (w : W₀) : J.map (algebraMap Γ(X, W₀) (X.presheaf.stalk w)) =
      IsFractionRing.denIdeal (X.presheaf.stalk w) f := by
    have := hW₀.isLocalization_stalk w
    exact IsFractionRing.map_denIdeal (hW₀.primeIdealOf w).asIdeal.primeCompl f
  obtain ⟨z, rfl⟩ : ∃ z' : W₀, (z' : X) = z := ⟨⟨z, hz⟩, rfl⟩
  have hz' : IsFractionRing.denIdeal (X.presheaf.stalk z) f =
      Ideal.span {(IsFractionRing.den (X.presheaf.stalk z) f : X.presheaf.stalk z)} := by
    have := hUFD z
    exact IsFractionRing.denIdeal_eq_span_den f
  have hloc := hW₀.isLocalization_stalk z
  have hden : (IsFractionRing.den (X.presheaf.stalk z) f : X.presheaf.stalk z) ∈
      J.map (algebraMap Γ(X, W₀) (X.presheaf.stalk z)) := by
    rw [hmap z, hz']
    exact Ideal.mem_span_singleton_self _
  obtain ⟨⟨j, s⟩, hjs⟩ := (IsLocalization.mem_map_algebraMap_iff
    (hW₀.primeIdealOf z).asIdeal.primeCompl _).1 hden
  dsimp only at hjs
  have hs := IsLocalization.map_units (X.presheaf.stalk z) s
  have h₁ : J.map (algebraMap Γ(X, W₀) (X.presheaf.stalk z)) ≤
      Ideal.span {algebraMap Γ(X, W₀) (X.presheaf.stalk z) j} := by
    rw [hmap z, hz', Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
      Ideal.mem_span_singleton']
    exact ⟨↑hs.unit⁻¹, by rw [mul_comm, ← hjs, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
  obtain ⟨h, hhM, hh⟩ :=
    IsFractionRing.exists_mul_mem_span_of_map_le (hW₀.primeIdealOf z).asIdeal.primeCompl h₁
  refine ⟨X.basicOpen h, (X.mem_basicOpen h z z.2).2
    (IsLocalization.map_units (X.presheaf.stalk z) ⟨h, hhM⟩),
    X.presheaf.map (homOfLE (X.basicOpen_le h)).op (j : Γ(X, W₀)), fun w hw ↦ ?_⟩
  obtain ⟨w, rfl⟩ : ∃ w' : W₀, (w' : X) = w := ⟨⟨w, X.basicOpen_le h hw⟩, rfl⟩
  rw [TopCat.Presheaf.germ_res_apply, ← hmap w]
  change _ = Ideal.span {algebraMap Γ(X, W₀) (X.presheaf.stalk w) j}
  have hu : IsUnit (algebraMap Γ(X, W₀) (X.presheaf.stalk w) h) :=
    (X.mem_basicOpen h w w.2).1 hw
  refine le_antisymm ?_ (Ideal.span_le.2 (Set.singleton_subset_iff.2
    (Ideal.mem_map_of_mem _ j.2)))
  rw [Ideal.map_le_iff_le_comap]
  intro j' hj'
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 (hh j' hj')
  refine Ideal.mem_comap.2 (Ideal.mem_span_singleton'.2
    ⟨↑hu.unit⁻¹ * algebraMap Γ(X, W₀) (X.presheaf.stalk w) r, ?_⟩)
  rw [mul_assoc, ← map_mul, hr, map_mul, ← mul_assoc, IsUnit.val_inv_mul, one_mul]

/-- The line bundle `𝒪(div_∞ f)` of the divisor of poles of a rational function `f` on an
integral locally noetherian scheme whose local rings are factorial, with the section `f`: at a
point `x` where `f` is the germ of a regular function `a`, the section vanishes iff `a` does
(Hartshorne II.6.11, II.6.13). -/
theorem exists_lineBundle_poleDivisor
    (hUFD : ∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)) :
    ∃ (L : X.LineBundle) (s : L.Fam ⊤), L.IsSection 1 ⊤ s ∧
      ∀ (V : X.Opens) (a : Γ(X, V)) (x : X) (hx : x ∈ V),
        algebraMap _ X.functionField (X.presheaf.germ V x hx a) = f →
          (x ∈ L.famLocus ⊤ s ↔ x ∈ X.basicOpen a) := by
  choose W hzW b hb using exists_denIdeal_eq_span_germ f hUFD
  have hne (z : X) : Nonempty (W z) := ⟨⟨z, hzW z⟩⟩
  set B : X → X.functionField := fun z ↦ X.germToFunctionField (W z) (b z) with hB
  have hBgerm (z w : X) (hw : w ∈ W z) :
      algebraMap _ X.functionField (X.presheaf.germ (W z) w hw (b z)) = B z :=
    algebraMap_germ_eq_germToFunctionField X hw (b z)
  -- `B z ≠ 0`: the ideal of denominators is not zero
  have hB0 (z : X) : B z ≠ 0 := by
    obtain ⟨n, d, hd⟩ := IsFractionRing.div_surjective (A := X.presheaf.stalk z) f
    have hdmem : (d : X.presheaf.stalk z) ∈ IsFractionRing.denIdeal (X.presheaf.stalk z) f :=
      ⟨n, by rw [← hd.2, mul_div_cancel₀ _ (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
        hd.1)]⟩
    rw [hb z z (hzW z), Ideal.mem_span_singleton] at hdmem
    rw [← hBgerm z z (hzW z)]
    intro h0
    rw [IsFractionRing.to_map_eq_zero_iff] at h0
    rw [h0, zero_dvd_iff] at hdmem
    exact nonZeroDivisors.ne_zero hd.1 hdmem
  -- the ratios `B z / B z'` are regular where both charts are defined
  have hratio (z z' w : X) (hw : w ∈ W z ⊓ W z') :
      ∃ g : X.presheaf.stalk w, algebraMap _ X.functionField g = B z / B z' := by
    have e := (hb z w hw.1).symm.trans (hb z' w hw.2)
    rw [Ideal.span_singleton_eq_span_singleton] at e
    obtain ⟨v, hv⟩ := e
    refine ⟨↑v⁻¹, ?_⟩
    have hv' : algebraMap _ X.functionField ((v⁻¹ : (X.presheaf.stalk w)ˣ) : X.presheaf.stalk w) =
        (algebraMap _ X.functionField (v : X.presheaf.stalk w))⁻¹ :=
      eq_inv_of_mul_eq_one_left (by rw [← map_mul, Units.inv_mul, map_one])
    have h0 := hB0 z
    rw [hv', ← hBgerm z w hw.1, ← hBgerm z' w hw.2, ← hv, map_mul]
    rw [← hBgerm z w hw.1] at h0
    field_simp
  choose u hu using fun z z' ↦ exists_unit_of_forall_regular (W z ⊓ W z') (B z / B z')
    (div_ne_zero (hB0 z) (hB0 z')) (hratio z z')
    (fun w hw ↦ by rw [inv_div]; exact hratio z' z w ⟨hw.2, hw.1⟩)
  -- `B z * f` is regular on `W z`
  have hreg (z w : X) (hw : w ∈ ⊤ ⊓ W z) :
      ∃ g : X.presheaf.stalk w, algebraMap _ X.functionField g = B z * f := by
    have hmem : X.presheaf.germ (W z) w hw.2 (b z) ∈
        IsFractionRing.denIdeal (X.presheaf.stalk w) f := by
      rw [hb z w hw.2]
      exact Ideal.mem_span_singleton_self _
    obtain ⟨g, hg⟩ := hmem
    exact ⟨g, by rw [hg, hBgerm]⟩
  choose s hs using fun z ↦ exists_section_of_forall_regular (⊤ ⊓ W z) (B z * f) (hreg z)
  let L : X.LineBundle :=
    { ι := X
      U := W
      iSup_eq_top := eq_top_iff.2 fun z _ ↦ Opens.mem_iSup.2 ⟨z, hzW z⟩
      g := u
      cocycle := fun i j k ↦ TopCat.Presheaf.section_ext X.sheaf _ _ _ fun w hw ↦
        IsFractionRing.injective (X.presheaf.stalk w) X.functionField (by
          change algebraMap _ _ (X.presheaf.germ _ w hw
            (X.presheaf.map _ (u i j : Γ(X, W i ⊓ W j)) *
              X.presheaf.map _ (u j k : Γ(X, W j ⊓ W k)))) =
            algebraMap _ _ (X.presheaf.germ _ w hw (X.presheaf.map _ (u i k : Γ(X, W i ⊓ W k))))
          rw [map_mul, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
            TopCat.Presheaf.germ_res_apply, map_mul, hu, hu, hu]
          field_simp [hB0 j]) }
  have hsec : L.IsSection 1 ⊤ s := fun i j ↦
    TopCat.Presheaf.section_ext X.sheaf _ _ _ fun w hw ↦
      IsFractionRing.injective (X.presheaf.stalk w) X.functionField (by
        change algebraMap _ _ (X.presheaf.germ _ w hw (X.presheaf.map _ (s i))) =
          algebraMap _ _ (X.presheaf.germ _ w hw (X.presheaf.map _
            ((u i j ^ ((1 : ℕ) : ℤ) : (Γ(X, W i ⊓ W j))ˣ) : Γ(X, W i ⊓ W j)) *
            X.presheaf.map _ (s j)))
        rw [Nat.cast_one, zpow_one, map_mul, TopCat.Presheaf.germ_res_apply,
          TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply, map_mul, hs, hs, hu]
        field_simp [hB0 j])
  refine ⟨L, s, hsec, fun V a x hx hfa ↦ ?_⟩
  have hxW : x ∈ ⊤ ⊓ W x := ⟨trivial, hzW x⟩
  rw [LineBundle.mem_famLocus_iff hsec (i := x) (hzW x), X.mem_basicOpen _ x hxW,
    X.mem_basicOpen _ x hx]
  have hgb : IsUnit (X.presheaf.germ (W x) x (hzW x) (b x)) := by
    have h1 : (1 : X.presheaf.stalk x) ∈ IsFractionRing.denIdeal (X.presheaf.stalk x) f :=
      ⟨X.presheaf.germ V x hx a, by rw [map_one, one_mul, hfa]⟩
    rw [hb x x (hzW x), Ideal.mem_span_singleton] at h1
    exact isUnit_of_dvd_one h1
  have e : X.presheaf.germ (⊤ ⊓ W x) x hxW (s x) =
      X.presheaf.germ (W x) x (hzW x) (b x) * X.presheaf.germ V x hx a :=
    IsFractionRing.injective (X.presheaf.stalk x) X.functionField (by
      rw [map_mul, hs, hBgerm, hfa])
  rw [e, IsUnit.mul_iff]
  exact ⟨fun h ↦ h.2, fun h ↦ ⟨hgb, h⟩⟩

end PoleDivisor

